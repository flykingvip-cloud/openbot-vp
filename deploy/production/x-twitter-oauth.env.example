# X (Twitter) OAuth — personal operational identity (user_operational_identity / x-twitter)
# Depends on: feat(oi) personal X OAuth primary path (#712 / c1f4b9596)
# Design: docs/design/oi-x-twitter-oauth-personal-identity-2026-10-14.md
#
# Register app: https://developer.x.com/en/portal/dashboard
# OAuth 2.0 → Type: Web App; enable PKCE.
# Callback URI must match exactly (UI uses window.location.origin):
#   https://admin.openbot.love/__openbot/user-operational-identity/oauth/callback
#   https://gw.openbot.love/__openbot/user-operational-identity/oauth/callback
# Scope (default below): tweet.read tweet.write users.read offline.access
# Without CLIENT_ID + CLIENT_SECRET, oauth.start stays simulateAllowed (dev/test only).

# Preferred primary names (adapter envPrefix=X_TWITTER → OPENBOT_USER_OPERATIONAL_IDENTITY_X_TWITTER_*)
OPENBOT_USER_OPERATIONAL_IDENTITY_X_TWITTER_CLIENT_ID=CHANGE_ME
OPENBOT_USER_OPERATIONAL_IDENTITY_X_TWITTER_CLIENT_SECRET=CHANGE_ME

# Optional: override redirect (defaults to callbackOrigin + path above when omitted)
# OPENBOT_USER_OPERATIONAL_IDENTITY_X_TWITTER_REDIRECT_URI=https://admin.openbot.love/__openbot/user-operational-identity/oauth/callback

# Optional: override authorize scope (space-separated)
# OPENBOT_USER_OPERATIONAL_IDENTITY_X_TWITTER_SCOPE=tweet.read tweet.write users.read offline.access

# Operator shorthand aliases (equivalent to the OPENBOT_USER_OPERATIONAL_IDENTITY_X_TWITTER_* keys)
# X_TWITTER_CLIENT_ID=CHANGE_ME
# X_TWITTER_CLIENT_SECRET=CHANGE_ME
# X_TWITTER_REDIRECT_URI=https://admin.openbot.love/__openbot/user-operational-identity/oauth/callback
