# Production environment — Primary names prefer OPENBOT_*.
# OPENCLAW_* aliases are accepted by runtime/docker-setup mirror helpers for back-compat.
# Do not commit filled copies.

# --- Image / compose ---
OPENBOT_IMAGE=openbot:prod
# OPENCLAW_IMAGE=openbot:prod

# --- Gateway ---
# Required for token auth (openssl rand -hex 32)
OPENBOT_GATEWAY_TOKEN=CHANGE_ME_LONG_RANDOM_HEX
# OPENCLAW_GATEWAY_TOKEN=  # alias only if you must

OPENBOT_GATEWAY_PORT=18789
# Host paths mounted into the container
OPENBOT_CONFIG_DIR=/var/lib/openbot/state
OPENBOT_WORKSPACE_DIR=/var/lib/openbot/workspace
OPENBOT_STATE_DIR=/home/node/.openclaw

# Public URLs (platform login, OAuth callbacks)
OPENBOT_PUBLIC_APP_BASE_URL=https://admin.CHANGE_ME.example
# OPENBOT_PUBLIC_WEB_BASE_URL=https://app.CHANGE_ME.example

# --- Personal operational identity: X (Twitter) OAuth (optional) ---
# Full sample: deploy/production/x-twitter-oauth.env.example
# Callback path: /__openbot/user-operational-identity/oauth/callback
# (origin = the host where personal settings are opened, e.g. admin.openbot.love / gw.openbot.love)
# OPENBOT_USER_OPERATIONAL_IDENTITY_X_TWITTER_CLIENT_ID=CHANGE_ME
# OPENBOT_USER_OPERATIONAL_IDENTITY_X_TWITTER_CLIENT_SECRET=CHANGE_ME
# OPENBOT_USER_OPERATIONAL_IDENTITY_X_TWITTER_REDIRECT_URI=https://admin.CHANGE_ME.example/__openbot/user-operational-identity/oauth/callback
# Aliases: X_TWITTER_CLIENT_ID / X_TWITTER_CLIENT_SECRET / X_TWITTER_REDIRECT_URI

# --- Security profile (Gate 0) ---
# Two mutually exclusive profiles (SECURITY.md Operator Trust Model,
# src/gateway/security-profile.ts). Startup fails closed when Managed requirements
# are not met — that is correct behavior; fix the env, never downgrade the profile.
#
# (a) Personal self-hosted (Profile A): leave everything below unset.
#     Derived profile is personal_local; data.mode stays "local".
#     Do NOT combine personal_local with OPENBOT_DATA_MODE=managed — the gateway
#     rejects that at startup (SECURITY_PROFILE_CONFLICT).
#
# (b) Production Managed Enterprise (Profile B, R10): a DEDICATED Gateway per tenant
#     (or per trust boundary). One tenant per process — own tenants-root subvolume,
#     own OPENBOT_GATEWAY_TOKEN, own browser state/queues/caches. Required set:
# OPENBOT_SECURITY_PROFILE=managed_enterprise
# OPENBOT_DATA_MODE=managed
# OPENBOT_TENANT_EXECUTION_BOUNDARY=dedicated
# OPENBOT_TENANTS_ROOT=/data/tenants
#     Pin the single tenant this dedicated process serves (managed non-multitenant):
# OPENBOT_TENANT_ID=CHANGE_ME_TENANT_ID
#
# shared_process is rejected at startup until shared-process I3 isolation is proven
# (SECURITY_PROFILE_MISSING_EXECUTION_BOUNDARY). Missing tenants root also fails
# closed (SECURITY_PROFILE_MISSING_TENANTS_ROOT).

# Shared-Gateway multi-tenant addressing — NOT approved for production traffic (R7).
# Only for pre-prod/canary after tenant-context B4 P1+P2+P4 are green AND the
# shared-process I3 isolation claim is separately proven/approved.
# OPENBOT_MULTITENANT=1

# Task Progress Ledger — keep unset/0 until staging canary in
# .kiro/specs/task-progress-ledger/rollout.md is signed off.
# OPENBOT_PROGRESS_LEDGER_ENABLED=0

# Never enable in production unless debugging a private network break-glass path
# OPENBOT_ALLOW_INSECURE_PRIVATE_WS=0

# --- Exec efficiency / inbound depth (P2 greyscale; all default OFF in code) ---
# See deploy/production/exec-efficiency-inbound-depth-greyscale.md
# Shadow classifies only; ROUTER applies chat-lane skip. Do NOT enable ROUTER in
# image/compose defaults — toggle on the host after shadow evidence is clean.
# OPENBOT_CHAT_INBOUND_DEPTH_SHADOW=0
# OPENBOT_CHAT_INBOUND_DEPTH_ROUTER=0
# OPENBOT_CHAT_INBOUND_KNOWLEDGE_POLICY=0
# OPENBOT_CHAT_INBOUND_TOOL_POLICY=0
# OPENBOT_CHAT_INBOUND_DEPTH_AGENT_ALLOWLIST=
# OPENBOT_CHAT_INBOUND_PERSIST_EARLY=0
# Optional richer stage latencies (local lifecycle emit only; no remote sink):
# OPENBOT_EXECUTION_ROUTER_OBSERVATION=0

# Node
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=1536

# --- HA Dual Controller (opt-in compose profile `ha`) ---
# Default `docker compose ... up -d` does NOT start the controller.
# Enable only when CommitSafety SQL is applied and DATABASE_URL points at HA DB:
#   docker compose -f deploy/production/docker-compose.prod.yml --env-file .env --profile ha up -d
#
# Production Auto Failover is NOT APPROVED. Keep HA_CONTROLLER_MODE=manual.
# Manual failover remains: docker compose run --rm openbot-ha-controller \
#   python -m controller run-once --to-holder … --to-db-role …
#
# DATABASE_URL=postgresql://openbot_controller:CHANGE_ME@db-host:5432/openbot
# HA_CONTROLLER_ID=controller-1
# HA_FAILURE_DOMAIN=az-a
# HA_CONTROLLER_VERSION=prod
# HA_CONTROLLER_MODE=manual
# HA_CONTROLLER_HEARTBEAT_INTERVAL_SEC=5
# OPENBOT_HA_CONTROLLER_IMAGE=openbot-ha-controller:local
