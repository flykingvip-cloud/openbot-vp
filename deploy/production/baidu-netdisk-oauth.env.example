# Baidu Netdisk OAuth (required for「百度扫码登录」QR flow)
# Register app: https://pan.baidu.com/union/console/applist
# Redirect URI must match exactly:
#   https://www.openbot.love/__openbot/knowledge/cloud-drive/oauth/callback
# Scope: basic,netdisk

OPENBOT_CLOUDDRIVE_BAIDU_APP_KEY=
OPENBOT_CLOUDDRIVE_BAIDU_APP_SECRET=
# Optional override (defaults from OPENBOT_PUBLIC_HOME_BASE_URL + path above)
# OPENBOT_CLOUDDRIVE_BAIDU_REDIRECT_URI=https://www.openbot.love/__openbot/knowledge/cloud-drive/oauth/callback
OPENBOT_PUBLIC_HOME_BASE_URL=https://www.openbot.love
