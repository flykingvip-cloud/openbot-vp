# Staging — Primary names only (Wave 3).
# Copy to the staging host; never commit filled secrets.
#   cp env.staging.example /var/lib/openbot/staging/.env
#   openssl rand -hex 32  → paste into OPENBOT_GATEWAY_TOKEN

# --- Image ---
OPENBOT_IMAGE=openbot:rc

# --- Gateway ---
OPENBOT_GATEWAY_TOKEN=CHANGE_ME_openssl_rand_hex_32
OPENBOT_GATEWAY_PORT=18789
OPENBOT_CONFIG_DIR=/var/lib/openbot/staging/state
OPENBOT_WORKSPACE_DIR=/var/lib/openbot/staging/workspace
OPENBOT_STATE_DIR=/home/node/.openclaw

# Must match the HTTPS origin used in the browser (and allowedOrigins).
OPENBOT_PUBLIC_APP_BASE_URL=https://admin.staging.CHANGE_ME.example

# SaaS data mode; multi-tenant flag stays off until B4 green
OPENBOT_DATA_MODE=managed
# OPENBOT_TENANTS_ROOT=/data/tenants
# OPENBOT_MULTITENANT=0

# Task Progress Ledger canary — default off. Staging / single-tenant only:
# OPENBOT_PROGRESS_LEDGER_ENABLED=1

# Break-glass — leave unset in staging unless debugging
# OPENBOT_ALLOW_INSECURE_PRIVATE_WS=0

# OCI image — do not compare against npm global latest (misleading for RC/prod containers)
OPENBOT_IMAGE_INSTALL=1

NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=1536
