<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Stage 55 — Windows employee Web shell host (ADR option 1).
    Targets WinUI 3 + WebView2. Build on a Windows machine with the Windows App
    SDK workload; this Mac checkout cannot compile or smoke the UI.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>OpenBot.EmployeeShell</RootNamespace>
    <ApplicationManifest>UI\app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <Page Update="UI\**\*.xaml" />
    <ApplicationDefinition Include="UI\App.xaml" />
    <Manifest Include="UI\app.manifest" />
  </ItemGroup>
</Project>
