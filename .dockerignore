# large app trees not needed for CLI build
apps/
assets/
Peekaboo/
Swabble/
Core/
Users/
vendor/

# Needed for building the Canvas A2UI bundle during Docker image builds.
# Keep the rest of apps/ and vendor/ excluded to avoid a large build context.
!apps/shared/
!apps/shared/OpenBotKit/
!apps/shared/OpenBotKit/Sources/
!apps/shared/OpenBotKit/Sources/OpenBotKit/
!apps/shared/OpenBotKit/Sources/OpenBotKit/Resources/
!apps/shared/OpenBotKit/Sources/OpenBotKit/Resources/tool-display.json
!apps/shared/OpenBotKit/Tools/
!apps/shared/OpenBotKit/Tools/CanvasA2UI/
!apps/shared/OpenBotKit/Tools/CanvasA2UI/**
!vendor/a2ui/
!vendor/a2ui/renderers/
!vendor/a2ui/renderers/lit/
!vendor/a2ui/renderers/lit/**

# Bundled skills must ship intact (vendor refs, sample assets, media samples)
!skills/
!skills/**
!skills/**/vendor/
!skills/**/vendor/**
!skills/**/assets/
!skills/**/assets/**
!skills/**/*.png
!skills/**/*.jpg
!skills/**/*.jpeg
!skills/**/*.webp
!skills/**/*.gif
!skills/**/*.mp4
!skills/**/*.mov
!skills/**/*.wav
!skills/**/*.mp3
