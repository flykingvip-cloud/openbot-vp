# OpenClaw .env example
#
# Quick start:
# 1) Copy this file to `.env` (for local runs from this repo), OR to `~/.openclaw/.env` (for launchd/systemd daemons).
# 2) Fill only the values you use.
# 3) Keep real secrets out of git.
#
# Env-source precedence for environment variables (highest -> lowest):
# process env, ./.env, ~/.openclaw/.env, then openclaw.json `env` block.
# Existing non-empty process env vars are not overridden by dotenv/config env loading.
# Note: direct config keys (for example `gateway.auth.token` or channel tokens in openclaw.json)
# are resolved separately from env loading and often take precedence over env fallbacks.

# -----------------------------------------------------------------------------
# Gateway auth + paths
# -----------------------------------------------------------------------------
# Recommended if the gateway binds beyond loopback.
OPENCLAW_GATEWAY_TOKEN=change-me-to-a-long-random-token
# Example generator: openssl rand -hex 32

# Optional alternative auth mode (use token OR password).
# OPENCLAW_GATEWAY_PASSWORD=change-me-to-a-strong-password

# Optional path overrides (defaults shown for reference).
# OPENCLAW_STATE_DIR=~/.openclaw
# OPENCLAW_CONFIG_PATH=~/.openclaw/openclaw.json
# OPENCLAW_HOME=~

# Optional: import missing keys from your login shell profile.
# OPENCLAW_LOAD_SHELL_ENV=1
# OPENCLAW_SHELL_ENV_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# Model provider API keys (set at least one)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...
# OPENCLAW_LIVE_OPENAI_KEY=sk-...
# OPENCLAW_LIVE_ANTHROPIC_KEY=sk-ant-...
# OPENCLAW_LIVE_GEMINI_KEY=...
# OPENAI_API_KEY_1=...
# ANTHROPIC_API_KEY_1=...
# GEMINI_API_KEY_1=...
# GOOGLE_API_KEY=...
# OPENAI_API_KEYS=sk-1,sk-2
# ANTHROPIC_API_KEYS=sk-ant-1,sk-ant-2
# GEMINI_API_KEYS=key-1,key-2

# Optional additional providers
# ZAI_API_KEY=...
# AI_GATEWAY_API_KEY=...
# MINIMAX_API_KEY=...
# SYNTHETIC_API_KEY=...

# -----------------------------------------------------------------------------
# Channels (only set what you enable)
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=123456:ABCDEF...
# DISCORD_BOT_TOKEN=...
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# Optional channel env fallbacks
# MATTERMOST_BOT_TOKEN=...
# MATTERMOST_URL=https://chat.example.com
# ZALO_BOT_TOKEN=...
# OPENCLAW_TWITCH_ACCESS_TOKEN=oauth:...

# -----------------------------------------------------------------------------
# Tools + voice/media (optional)
# -----------------------------------------------------------------------------
# BRAVE_API_KEY=...
# PERPLEXITY_API_KEY=pplx-...
# FIRECRAWL_API_KEY=...

# ELEVENLABS_API_KEY=...
# XI_API_KEY=...  # alias for ElevenLabs
# DEEPGRAM_API_KEY=...

# -----------------------------------------------------------------------------
# My Operational Identity (per-user external execution accounts)
# -----------------------------------------------------------------------------
# Personal accounts that Agents may call on the user's behalf (GitHub issues,
# email, etc.). Without these, GitHub binding falls back to a simulated OAuth
# flow useful for local testing. Set all three to enable real GitHub OAuth.
# Register an OAuth App at https://github.com/settings/developers and set its
# callback to: <gateway-origin>/__openbot/user-operational-identity/oauth/callback
# OPENBOT_USER_OPERATIONAL_IDENTITY_GITHUB_CLIENT_ID=...
# OPENBOT_USER_OPERATIONAL_IDENTITY_GITHUB_CLIENT_SECRET=...
# OPENBOT_USER_OPERATIONAL_IDENTITY_GITHUB_REDIRECT_URI=https://gateway.example.com/__openbot/user-operational-identity/oauth/callback

# X (Twitter) personal OAuth2 + PKCE (personal settings → 授权 → X).
# Register an OAuth 2.0 app at https://developer.x.com/ and set callback to the same
# user-operational-identity OAuth callback path as GitHub.
# OPENBOT_USER_OPERATIONAL_IDENTITY_X_TWITTER_CLIENT_ID=...
# OPENBOT_USER_OPERATIONAL_IDENTITY_X_TWITTER_CLIENT_SECRET=...
# OPENBOT_USER_OPERATIONAL_IDENTITY_X_TWITTER_REDIRECT_URI=https://gateway.example.com/__openbot/user-operational-identity/oauth/callback
# Optional scope override (default: tweet.read tweet.write users.read offline.access)
# OPENBOT_USER_OPERATIONAL_IDENTITY_X_TWITTER_SCOPE=tweet.read tweet.write users.read offline.access
# Aliases (equivalent):
# X_TWITTER_CLIENT_ID=...
# X_TWITTER_CLIENT_SECRET=...
# X_TWITTER_REDIRECT_URI=https://gateway.example.com/__openbot/user-operational-identity/oauth/callback

# The personal-email provider reuses the platform SMTP settings below.
# OPENBOT_SMTP_HOST=smtp.example.com
# OPENBOT_SMTP_PORT=587
# OPENBOT_SMTP_USER=noreply@example.com
# OPENBOT_SMTP_PASS=...
# OPENBOT_SMTP_FROM=OpenBot <noreply@example.com>
# OPENBOT_SMTP_STARTTLS=1

# Xiaohongshu (小红书) personal-note connector.
# Recommended sidecar: https://github.com/vmxmy/xiaohongshu-mcp (Docker :18060)
# - builtin:simulate                 local simulated publish (no browser)
# - http://127.0.0.1:18060           xiaohongshu-mcp REST (auto-detected)
# - https://your-connector.example.com  generic OpenBot dialect (/v1/notes)
# OPENBOT_XIAOHONGSHU_API_BASE=http://127.0.0.1:18060
# OPENBOT_XIAOHONGSHU_CONNECTOR=xiaohongshu-mcp
# Bind UI: paste creator Cookie header (a1=...; web_session=...) or EditThisCookie JSON.

# -----------------------------------------------------------------------------
# Account Worker sandbox images (operator-controlled; Gateway never supplies)
# -----------------------------------------------------------------------------
# Flags default OFF. Docker driver is a second opt-in.
# OPENBOT_ACCOUNT_WORKER=0
# OPENBOT_ACCOUNT_WORKER_DOCKER=0
# Canonical exec image. openclaw-sandbox:bookworm-slim is a temporary alias.
# OPENBOT_ACCOUNT_WORKER_EXEC_IMAGE=openbot-sandbox:bookworm-slim
# Canonical browser image. openclaw-sandbox-browser:bookworm-slim is a temporary alias.
# OPENBOT_ACCOUNT_WORKER_BROWSER_IMAGE=openbot-sandbox-browser:bookworm-slim
# Legacy exec-only override used by alpine smoke e2e:
# OPENBOT_ACCOUNT_WORKER_DOCKER_IMAGE=alpine:3.20
# Gated real-daemon e2e:
# OPENBOT_ACCOUNT_WORKER_DOCKER_E2E=1
