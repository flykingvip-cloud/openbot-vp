+/**
+ * Agent growth lifecycle broadcasts (mission_ready, activated, false_ready_detected).
+ * Shared by RPC recompute paths and background operational-metrics recompute.
+ *
+ * 模块边界说明：`emitGrowthEvents` 原本内联在 `server-methods/agent-growth.ts` 里，这里
+ * 抽成独立模块以**对齐 main 上已存在的引用面**（`background-recompute.ts` 与
+ * `server.impl.ts` 都按这个路径 import），避免合并时在 agent-growth.ts 上产生冲突。
+ *
+ * `registerGrowthEventBroadcast` / `getGrowthEventBroadcast` 目前在本分支还没有调用方：
+ * 它们的消费者是 `background-recompute.ts`（后台重算）与 gateway 启动注册，而
+ * `background-recompute.ts` 依赖 `tenant-agent-dir.ts` → `tenant-context.ts`，属另一条
+ * 恢复线（见 main 恢复路由 L2）。这不是投机性接口——main 上已有两个文件按这组名字
+ * import，先补齐边界是为了让那条线落地时不必再改本文件。
+ */
+
+import { detectFalseReady } from "./operational-score.js";
+import type { GrowthStatus } from "./types.js";
+
+export type GrowthBroadcast = (event: string, payload: unknown) => void;
+
+let registeredBroadcast: GrowthBroadcast | undefined;
+
+/** Gateway startup registers WS broadcast; tests may inject a spy. */
+export function registerGrowthEventBroadcast(broadcast: GrowthBroadcast | undefined): void {
+  registeredBroadcast = broadcast;
+}
+
+export function getGrowthEventBroadcast(): GrowthBroadcast | undefined {
+  return registeredBroadcast;
+}
+
+/**
+ * Broadcast when lifecycle / false-ready crosses thresholds (R7.4/7.5, R16).
+ */
+export function emitGrowthEvents(
+  broadcast: GrowthBroadcast | undefined,
+  ref: { idKey: "agentId" | "groupId"; id: string },
+  prev: GrowthStatus | null,
+  next: GrowthStatus,
+): void {
+  if (!broadcast) {
+    return;
+  }
+  const base = { [ref.idKey]: ref.id, lifecycleState: next.lifecycleState, ts: Date.now() };
+  if (prev?.lifecycleState !== "mission_ready" && next.lifecycleState === "mission_ready") {
+    broadcast("agent_growth.mission_ready", { ...base, activationScore: next.activationScore });
+  }
+  if (!prev?.isActivated && next.isActivated) {
+    broadcast("agent_growth.activated", { ...base, activatedAtMs: next.activatedAtMs ?? null });
+  }
+  const prevFalseReady = prev
+    ? detectFalseReady(prev.activationScore, prev.operationalScore)
+    : false;
+  const nextFalseReady = detectFalseReady(next.activationScore, next.operationalScore);
+  if (!prevFalseReady && nextFalseReady) {
+    broadcast("agent_growth.false_ready_detected", {
+      ...base,
+      activationScore: next.activationScore,
+      operationalScore: next.operationalScore,
+    });
+  }
+}
diff --git a/src/gateway/agent-growth/skill-draft-curation.ts b/src/gateway/agent-growth/skill-draft-curation.ts
new file mode 100644
index 0000000000..bced57b9f0
--- /dev/null
+++ b/src/gateway/agent-growth/skill-draft-curation.ts
@@ -0,0 +1,182 @@
+/**
+ * 复用阈值策展：反复被证明有效的经验 → 自动沉淀为**技能草稿**（待人工审核）。
+ *
+ * 这是"越用越强"叙事此前唯一完全缺失的一环。原实现里晋升门禁看的是群参与率，
+ * 与复用次数无关；capsule/asset 数据模型里也没有任何计数字段。
+ *
+ * 现在的口径：
+ *  - **复用** = 学习资产真的被注入进系统提示词（`learning-recall.ts` 记账），
+ *    不是被创建、也不是被查看；
+ *  - 同一条经验反复出现（多个资产同源）也算重复验证；
+ *  - 达阈值 → 生成 `draft` 状态技能，**不自动发布**，等人工审核。
+ */
+
+import type { AgentLearningAsset } from "@openbot/collaboration-core";
+
+/** 累计复用次数阈值（跨簇求和）。 */
+export const DEFAULT_REUSE_THRESHOLD = 3;
+/** 同一条经验重复出现的资产数阈值。 */
+export const DEFAULT_OCCURRENCE_THRESHOLD = 3;
+
+export type SkillDraftCandidate = {
+  /** 稳定簇标识，用于幂等（同一簇只策展一次）。 */
+  clusterKey: string;
+  assetIds: string[];
+  botId: string;
+  assetType: NonNullable<AgentLearningAsset["assetType"]>;
+  /** 触发条件命中的原因，进入草稿说明便于审核者判断。 */
+  trigger: "reuse_threshold" | "occurrence_threshold";
+  totalReuse: number;
+  occurrences: number;
+  title: string;
+  lesson: string;
+  capabilities: string[];
+};
+
+function readText(value: unknown): string | null {
+  return typeof value === "string" && value.trim() ? value.trim() : null;
+}
+
+function readStringList(value: unknown): string[] {
+  return Array.isArray(value)
+    ? value
+        .filter((entry): entry is string => typeof entry === "string")
+        .map((entry) => entry.trim())
+        .filter(Boolean)
+    : [];
+}
+
+/**
+ * 簇标识：优先用结构化的失败原因（同一根因的经验应归为一簇），
+ * 否则回落到归一化后的教训正文。
+ */
+export function resolveClusterKey(asset: AgentLearningAsset): string | null {
+  const content = asset.abstractedContent ?? {};
+  const source = (content.source ?? {}) as Record<string, unknown>;
+  const assetType = asset.assetType ?? "lesson";
+  const reason = readText(source.reason);
+  if (reason) {
+    return `${assetType}::reason::${reason.toLowerCase()}`;
+  }
+  const lesson = readText(content.lesson) ?? readText(content.title) ?? readText(content.summary);
+  if (!lesson) {
+    return null;
+  }
+  const normalized = lesson
+    .toLowerCase()
+    .replace(/[\s\p{P}\p{S}]+/gu, "")
+    .slice(0, 80);
+  return normalized ? `${assetType}::lesson::${normalized}` : null;
+}
+
+function isCuratable(asset: AgentLearningAsset): boolean {
+  if (asset.status !== undefined && asset.status !== "active") {
+    return false;
+  }
+  // 已策展过的资产不再参与（幂等）。
+  return !asset.curatedSkillId;
+}
+
+/**
+ * 纯函数：从学习资产推导出应当沉淀为技能草稿的候选簇。
+ *
+ * 只要满足**累计复用**或**重复出现**任一阈值即毕业；两个阈值都不满足则不产出，
+ * 避免把偶发经验包装成"能力"。
+ */
+export function deriveSkillDraftCandidates(
+  assets: AgentLearningAsset[],
+  opts?: { reuseThreshold?: number; occurrenceThreshold?: number },
+): SkillDraftCandidate[] {
+  const reuseThreshold = Math.max(1, opts?.reuseThreshold ?? DEFAULT_REUSE_THRESHOLD);
+  const occurrenceThreshold = Math.max(
+    1,
+    opts?.occurrenceThreshold ?? DEFAULT_OCCURRENCE_THRESHOLD,
+  );
+
+  const clusters = new Map<string, AgentLearningAsset[]>();
+  for (const asset of assets) {
+    if (!isCuratable(asset)) {
+      continue;
+    }
+    const key = resolveClusterKey(asset);
+    if (!key) {
+      continue;
+    }
+    // 簇按 bot 隔离：技能是归属到具体机器人的资产。
+    const scopedKey = `${asset.botId}::${key}`;
+    const bucket = clusters.get(scopedKey);
+    if (bucket) {
+      bucket.push(asset);
+    } else {
+      clusters.set(scopedKey, [asset]);
+    }
+  }
+
+  const candidates: SkillDraftCandidate[] = [];
+  for (const [clusterKey, bucket] of clusters) {
+    const totalReuse = bucket.reduce((sum, asset) => sum + (asset.reuseCount ?? 0), 0);
+    const occurrences = bucket.length;
+    const meetsReuse = totalReuse >= reuseThreshold;
+    const meetsOccurrence = occurrences >= occurrenceThreshold;
+    if (!meetsReuse && !meetsOccurrence) {
+      continue;
+    }
+    const newest = bucket.toSorted(
+      (left, right) => (right.updatedAt ?? 0) - (left.updatedAt ?? 0),
+    )[0];
+    if (!newest) {
+      continue;
+    }
+    const content = newest.abstractedContent ?? {};
+    const lesson =
+      readText(content.lesson) ?? readText(content.summary) ?? readText(content.title) ?? "";
+    if (!lesson) {
+      continue;
+    }
+    candidates.push({
+      clusterKey,
+      assetIds: bucket.map((asset) => asset.assetId),
+      botId: newest.botId,
+      assetType: newest.assetType ?? "lesson",
+      trigger: meetsReuse ? "reuse_threshold" : "occurrence_threshold",
+      totalReuse,
+      occurrences,
+      title: readText(content.title) ?? lesson.slice(0, 60),
+      lesson,
+      capabilities: [
+        ...new Set([
+          ...readStringList(content.capabilities),
+          ...readStringList(newest.metadata?.skills),
+        ]),
+      ],
+    });
+  }
+  return candidates.toSorted((left, right) => right.totalReuse - left.totalReuse);
+}
+
+/** 由候选簇构造技能草稿的 profile（纯函数，便于单测与审核预览）。 */
+export function buildSkillDraftProfile(candidate: SkillDraftCandidate): {
+  name: string;
+  summary: string;
+  visibility: "private";
+  assetType: "skill";
+  tags: string[];
+  usageExamples: string[];
+  inputDescription: string;
+  outputDescription: string;
+} {
+  const reasonLabel =
+    candidate.trigger === "reuse_threshold"
+      ? `累计复用 ${candidate.totalReuse} 次`
+      : `重复出现 ${candidate.occurrences} 次`;
+  return {
+    name: `经验沉淀：${candidate.title}`.slice(0, 120),
+    summary: `${candidate.lesson}（${reasonLabel}，由学习资产自动策展，待人工审核）`.slice(0, 500),
+    visibility: "private",
+    assetType: "skill",
+    tags: [...new Set(["经验沉淀", candidate.assetType, ...candidate.capabilities])].slice(0, 10),
+    usageExamples: [candidate.lesson].slice(0, 3),
+    inputDescription: "触发同类任务时自动参考本经验",
+    outputDescription: "遵循该经验的执行结果",
+  };
+}
diff --git a/src/gateway/agent-growth/working-style-effectiveness.test.ts b/src/gateway/agent-growth/working-style-effectiveness.test.ts
new file mode 100644
index 0000000000..109dc3a9cd
--- /dev/null
+++ b/src/gateway/agent-growth/working-style-effectiveness.test.ts
@@ -0,0 +1,108 @@
+import { describe, expect, it } from "vitest";
+import {
+  aggregateWorkingStyleEffectiveness,
+  resolveWorkingStyleCohort,
+  type WorkingStyleEffectivenessInput,
+  workingStyleDeltaSignature,
+} from "./working-style-effectiveness.js";
+
+describe("workingStyleDeltaSignature", () => {
+  it("is order-independent and canonical", () => {
+    expect(
+      workingStyleDeltaSignature({
+        riskPreference: "conservative",
+        decisionPreference: "confirm_first",
+      }),
+    ).toBe("decisionPreference=confirm_first;riskPreference=conservative");
+    expect(
+      workingStyleDeltaSignature({
+        decisionPreference: "confirm_first",
+        riskPreference: "conservative",
+      }),
+    ).toBe("decisionPreference=confirm_first;riskPreference=conservative");
+  });
+
+  it("returns (none) for an empty delta and ignores null/undefined", () => {
+    expect(workingStyleDeltaSignature({})).toBe("(none)");
+    expect(
+      workingStyleDeltaSignature({ riskPreference: undefined, decisionPreference: null }),
+    ).toBe("(none)");
+  });
+});
+
+describe("resolveWorkingStyleCohort", () => {
+  it("is stable for the same agent and returns all-treatment at 0 control fraction", () => {
+    const a = resolveWorkingStyleCohort("agent-x", 0.2);
+    const b = resolveWorkingStyleCohort("agent-x", 0.2);
+    expect(a).toBe(b);
+    expect(resolveWorkingStyleCohort("agent-x", 0)).toBe("treatment");
+  });
+
+  it("assigns roughly the requested control fraction across many agents", () => {
+    let control = 0;
+    const n = 2000;
+    for (let i = 0; i < n; i += 1) {
+      if (resolveWorkingStyleCohort(`agent-${i}`, 0.2) === "control") {
+        control += 1;
+      }
+    }
+    const fraction = control / n;
+    // within a tolerance band around 0.2
+    expect(fraction).toBeGreaterThan(0.1);
+    expect(fraction).toBeLessThan(0.3);
+  });
+});
+
+describe("aggregateWorkingStyleEffectiveness", () => {
+  function item(
+    overrides: Partial<WorkingStyleEffectivenessInput> = {},
+  ): WorkingStyleEffectivenessInput {
+    return {
+      agentId: "a1",
+      appliedDelta: { riskPreference: "conservative" },
+      status: "improved",
+      deltaScore: 10,
+      rolledBack: false,
+      ...overrides,
+    };
+  }
+
+  it("aggregates overall counts, improvedRate and avgDeltaScore", () => {
+    const agg = aggregateWorkingStyleEffectiveness([
+      item({ agentId: "a1", status: "improved", deltaScore: 10 }),
+      item({ agentId: "a2", status: "regressed", deltaScore: -6, rolledBack: true }),
+      item({ agentId: "a3", status: "inconclusive", deltaScore: null }),
+    ]);
+    expect(agg.overall.total).toBe(3);
+    expect(agg.overall.improved).toBe(1);
+    expect(agg.overall.regressed).toBe(1);
+    expect(agg.overall.inconclusive).toBe(1);
+    expect(agg.overall.rolledBack).toBe(1);
+    expect(agg.overall.improvedRate).toBeCloseTo(0.5); // 1 / (1+1)
+    expect(agg.overall.avgDeltaScore).toBeCloseTo(2); // (10 + -6) / 2
+  });
+
+  it("groups by delta signature and ranks by net effectiveness", () => {
+    const agg = aggregateWorkingStyleEffectiveness([
+      item({ agentId: "a1", appliedDelta: { riskPreference: "conservative" }, status: "improved" }),
+      item({ agentId: "a2", appliedDelta: { riskPreference: "conservative" }, status: "improved" }),
+      item({
+        agentId: "a3",
+        appliedDelta: { decisionPreference: "autonomous" },
+        status: "regressed",
+      }),
+    ]);
+    expect(agg.bySignature[0]?.signature).toBe("riskPreference=conservative");
+    expect(agg.bySignature[0]?.netEffectiveness).toBe(1);
+    expect(agg.bySignature.at(-1)?.signature).toBe("decisionPreference=autonomous");
+    expect(agg.bySignature.at(-1)?.netEffectiveness).toBe(-1);
+  });
+
+  it("splits into treatment/control cohorts summing to total", () => {
+    const agg = aggregateWorkingStyleEffectiveness(
+      Array.from({ length: 20 }, (_unused, i) => item({ agentId: `agent-${i}` })),
+      { controlFraction: 0.2 },
+    );
+    expect(agg.byCohort.treatment.total + agg.byCohort.control.total).toBe(20);
+  });
+});
diff --git a/src/gateway/agent-growth/working-style-effectiveness.ts b/src/gateway/agent-growth/working-style-effectiveness.ts
new file mode 100644
index 0000000000..a7911886eb
--- /dev/null
+++ b/src/gateway/agent-growth/working-style-effectiveness.ts
@@ -0,0 +1,177 @@
+/**
+ * 跨 agent 行为改变有效性聚合分析 + A/B 分组（纯函数，便于单测）。
+ *
+ * 输入：各 agent 最近一次 Working DNA 变更的效果（appliedDelta + status + deltaScore + rolledBack）。
+ * 输出：
+ *  - overall：整体 improved/regressed/inconclusive/rolledBack 计数、improvedRate、平均 deltaScore。
+ *  - bySignature：按 delta 签名（哪种行为改变）聚合的有效性——回答"哪种行为改变最有效"（观察性 A/B：
+ *    同一"处理"(签名)下 improved vs regressed 的对比即处理效应）。
+ *  - byCohort：按稳定 cohort（treatment/control）拆分的有效性——为随机留出(holdout)式 A/B 提供分析骨架。
+ *
+ * 说明：真正的随机留出（control 组跳过自适应）会使 control 组暂时不受益，属产品/安全决策，默认不启用；
+ * `resolveWorkingStyleCohort` 提供稳定分组原语，启用留出后 byCohort 对比才成为真正的随机 A/B。
+ */
+
+export type WorkingStyleEffectStatus = "improved" | "regressed" | "inconclusive";
+
+export type WorkingStyleEffectivenessInput = {
+  agentId: string;
+  appliedDelta: Record<string, unknown>;
+  status: WorkingStyleEffectStatus | null;
+  deltaScore: number | null;
+  rolledBack: boolean;
+};
+
+export type WorkingStyleEffectivenessBucket = {
+  total: number;
+  improved: number;
+  regressed: number;
+  inconclusive: number;
+  rolledBack: number;
+  /** improved / (improved + regressed)；无结论样本 → null。 */
+  improvedRate: number | null;
+  /** 已评估样本的平均 deltaScore；无则 null。 */
+  avgDeltaScore: number | null;
+};
+
+export type WorkingStyleSignatureStats = WorkingStyleEffectivenessBucket & {
+  signature: string;
+  /** (improved - regressed) / total ∈ [-1, 1]。 */
+  netEffectiveness: number;
+};
+
+export type WorkingStyleCohort = "treatment" | "control";
+
+export type WorkingStyleEffectivenessAggregate = {
+  overall: WorkingStyleEffectivenessBucket;
+  bySignature: WorkingStyleSignatureStats[];
+  byCohort: Record<WorkingStyleCohort, WorkingStyleEffectivenessBucket>;
+};
+
+/** delta 的规范签名（键排序 + key=value 拼接），作为"哪种行为改变"的聚合键。 */
+export function workingStyleDeltaSignature(delta: Record<string, unknown>): string {
+  const keys = Object.keys(delta)
+    .filter((key) => delta[key] !== undefined && delta[key] !== null)
+    .toSorted();
+  if (keys.length === 0) {
+    return "(none)";
+  }
+  return keys.map((key) => `${key}=${String(delta[key])}`).join(";");
+}
+
+/**
+ * 稳定 cohort 分配（FNV-1a 哈希 agentId → [0,1)）：< controlFraction 归 control，否则 treatment。
+ * 稳定 = 同一 agent 始终同组，便于长期 A/B。controlFraction≤0 时全部 treatment。
+ */
+export function resolveWorkingStyleCohort(
+  agentId: string,
+  controlFraction = 0.1,
+): WorkingStyleCohort {
+  const fraction = Math.max(0, Math.min(1, controlFraction));
+  if (fraction <= 0) {
+    return "treatment";
+  }
+  let hash = 2166136261;
+  for (let i = 0; i < agentId.length; i += 1) {
+    hash ^= agentId.charCodeAt(i);
+    hash = Math.imul(hash, 16777619);
+  }
+  const normalized = ((hash >>> 0) % 10000) / 10000;
+  return normalized < fraction ? "control" : "treatment";
+}
+
+/** 累加一条记录到可变累加器（内部用；improvedRate/avgDeltaScore 在 finalize 时算）。 */
+type BucketAccumulator = {
+  total: number;
+  improved: number;
+  regressed: number;
+  inconclusive: number;
+  rolledBack: number;
+  deltaSum: number;
+  deltaCount: number;
+};
+
+function newAccumulator(): BucketAccumulator {
+  return {
+    total: 0,
+    improved: 0,
+    regressed: 0,
+    inconclusive: 0,
+    rolledBack: 0,
+    deltaSum: 0,
+    deltaCount: 0,
+  };
+}
+
+function accumulate(acc: BucketAccumulator, item: WorkingStyleEffectivenessInput): void {
+  acc.total += 1;
+  if (item.status === "improved") {
+    acc.improved += 1;
+  } else if (item.status === "regressed") {
+    acc.regressed += 1;
+  } else if (item.status === "inconclusive") {
+    acc.inconclusive += 1;
+  }
+  if (item.rolledBack) {
+    acc.rolledBack += 1;
+  }
+  if (typeof item.deltaScore === "number" && Number.isFinite(item.deltaScore)) {
+    acc.deltaSum += item.deltaScore;
+    acc.deltaCount += 1;
+  }
+}
+
+function finalizeBucket(acc: BucketAccumulator): WorkingStyleEffectivenessBucket {
+  const conclusive = acc.improved + acc.regressed;
+  return {
+    total: acc.total,
+    improved: acc.improved,
+    regressed: acc.regressed,
+    inconclusive: acc.inconclusive,
+    rolledBack: acc.rolledBack,
+    improvedRate: conclusive > 0 ? acc.improved / conclusive : null,
+    avgDeltaScore: acc.deltaCount > 0 ? acc.deltaSum / acc.deltaCount : null,
+  };
+}
+
+/** 聚合跨 agent 的行为改变有效性。 */
+export function aggregateWorkingStyleEffectiveness(
+  items: WorkingStyleEffectivenessInput[],
+  opts?: { controlFraction?: number },
+): WorkingStyleEffectivenessAggregate {
+  const overall = newAccumulator();
+  const bySignature = new Map<string, BucketAccumulator>();
+  const treatment = newAccumulator();
+  const control = newAccumulator();
+
+  for (const item of items) {
+    accumulate(overall, item);
+
+    const signature = workingStyleDeltaSignature(item.appliedDelta);
+    const sigAcc = bySignature.get(signature) ?? newAccumulator();
+    accumulate(sigAcc, item);
+    bySignature.set(signature, sigAcc);
+
+    const cohort = resolveWorkingStyleCohort(item.agentId, opts?.controlFraction);
+    accumulate(cohort === "control" ? control : treatment, item);
+  }
+
+  const signatureStats: WorkingStyleSignatureStats[] = [...bySignature.entries()]
+    .map(([signature, acc]) => ({
+      signature,
+      ...finalizeBucket(acc),
+      netEffectiveness: acc.total > 0 ? (acc.improved - acc.regressed) / acc.total : 0,
+    }))
+    // 有效性高者在前；并列则样本多者在前。
+    .toSorted((left, right) =>
+      right.netEffectiveness !== left.netEffectiveness
+        ? right.netEffectiveness - left.netEffectiveness
+        : right.total - left.total,
+    );
+
+  return {
+    overall: finalizeBucket(overall),
+    bySignature: signatureStats,
+    byCohort: { treatment: finalizeBucket(treatment), control: finalizeBucket(control) },
+  };
+}
diff --git a/src/gateway/agent-growth/working-style-store.test.ts b/src/gateway/agent-growth/working-style-store.test.ts
new file mode 100644
index 0000000000..49e36a2239
--- /dev/null
+++ b/src/gateway/agent-growth/working-style-store.test.ts
@@ -0,0 +1,147 @@
+/**
+ * Working DNA 自调闭环的端到端行为（真实文件）。
+ *
+ * 这一层曾在 2026-07-12 实现过但从未合入，导致 main 只留下调用点没有实现。恢复后必须
+ * 有测试锁住闭环语义：行为改变 → 二阶评估 → 回归则自动回滚 → 抑制同一 delta 复发。
+ */
+
+import fs from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import type { OpenClawConfig } from "../../config/config.js";
+import { DEFAULT_WORKING_STYLE } from "./genome.js";
+import {
+  applyOperationalSignalsToWorkingStyle,
+  assessAndMarkWorkingStyleEffect,
+  readRobotWorkingStyle,
+  readWorkingStyleChange,
+  readWorkingStyleEffectStats,
+  resolveWorkingStyleInstructions,
+} from "./working-style-store.js";
+
+const AGENT_ID = "dna-bot";
+let tmpDir = "";
+let cfg: OpenClawConfig;
+
+beforeEach(async () => {
+  tmpDir = await fs.mkdtemp(path.join(os.tmpdir(), "openbot-working-dna-"));
+  cfg = { agents: { list: [{ id: AGENT_ID, agentDir: tmpDir }] } } as unknown as OpenClawConfig;
+});
+
+afterEach(async () => {
+  await fs.rm(tmpDir, { recursive: true, force: true });
+});
+
+describe("Working DNA：行为改变写入", () => {
+  it("未学习过的 agent 不注入任何提示词（向后兼容）", async () => {
+    expect(await resolveWorkingStyleInstructions(cfg, AGENT_ID)).toBeUndefined();
+    expect(await readRobotWorkingStyle(cfg, AGENT_ID)).toBeNull();
+  });
+
+  it("高接管率 → 变保守并要求先确认，且渲染进提示词", async () => {
+    const applied = await applyOperationalSignalsToWorkingStyle(
+      cfg,
+      AGENT_ID,
+      { humanTakeoverRate: 0.8, taskSuccessRate: 0.4 },
+      60,
+    );
+    expect(applied?.riskPreference).toBe("conservative");
+    expect(applied?.decisionPreference).toBe("confirm_first");
+
+    const instructions = await resolveWorkingStyleInstructions(cfg, AGENT_ID);
+    expect(instructions).toBeTruthy();
+    expect(instructions).not.toBe("");
+
+    const change = await readWorkingStyleChange(cfg, AGENT_ID);
+    expect(change?.baselineOperationalScore).toBe(60);
+    expect(change?.assessedAtMs).toBeNull();
+    expect(change?.previousValues).toMatchObject({
+      riskPreference: DEFAULT_WORKING_STYLE.riskPreference,
+    });
+  });
+
+  it("信号不触发规则时不写盘（无变更不留痕）", async () => {
+    const applied = await applyOperationalSignalsToWorkingStyle(
+      cfg,
+      AGENT_ID,
+      { humanTakeoverRate: 0.3, taskSuccessRate: 0.7 },
+      50,
+    );
+    expect(applied).toBeNull();
+    expect(await readWorkingStyleChange(cfg, AGENT_ID)).toBeNull();
+  });
+});
+
+describe("Working DNA：二阶评估与自动回滚", () => {
+  async function seedConservativeChange(baseline: number) {
+    await applyOperationalSignalsToWorkingStyle(
+      cfg,
+      AGENT_ID,
+      { humanTakeoverRate: 0.8, taskSuccessRate: 0.4 },
+      baseline,
+    );
+  }
+
+  it("表现变差 → 自动回滚到变更前的值并记录 rolledBack", async () => {
+    await seedConservativeChange(70);
+    const effect = await assessAndMarkWorkingStyleEffect(cfg, AGENT_ID, 40);
+
+    expect(effect?.status).toBe("regressed");
+    expect(effect?.rolledBack).toBe(true);
+    expect(effect?.newlyAssessed).toBe(true);
+
+    const style = await readRobotWorkingStyle(cfg, AGENT_ID);
+    expect(style?.riskPreference).toBe(DEFAULT_WORKING_STYLE.riskPreference);
+    expect(style?.decisionPreference).toBe(DEFAULT_WORKING_STYLE.decisionPreference);
+  });
+
+  it("回滚后抑制同一 delta 复发（防振荡）", async () => {
+    await seedConservativeChange(70);
+    await assessAndMarkWorkingStyleEffect(cfg, AGENT_ID, 40);
+
+    // 同样的信号 → 同样的 delta → 被抑制，不再写入。
+    const retry = await applyOperationalSignalsToWorkingStyle(
+      cfg,
+      AGENT_ID,
+      { humanTakeoverRate: 0.8, taskSuccessRate: 0.4 },
+      40,
+    );
+    expect(retry).toBeNull();
+  });
+
+  it("表现变好 → 保留变更，不回滚", async () => {
+    await seedConservativeChange(50);
+    const effect = await assessAndMarkWorkingStyleEffect(cfg, AGENT_ID, 80);
+
+    expect(effect?.status).toBe("improved");
+    expect(effect?.rolledBack).toBe(false);
+    const style = await readRobotWorkingStyle(cfg, AGENT_ID);
+    expect(style?.riskPreference).toBe("conservative");
+  });
+
+  it("变化幅度过小 → inconclusive，保留记录待后续评估", async () => {
+    await seedConservativeChange(60);
+    const effect = await assessAndMarkWorkingStyleEffect(cfg, AGENT_ID, 62);
+
+    expect(effect?.status).toBe("inconclusive");
+    expect(effect?.newlyAssessed).toBe(false);
+    expect((await readWorkingStyleChange(cfg, AGENT_ID))?.assessedAtMs).toBeNull();
+  });
+
+  it("没有待评估变更时返回 null（幂等）", async () => {
+    expect(await assessAndMarkWorkingStyleEffect(cfg, AGENT_ID, 90)).toBeNull();
+    await seedConservativeChange(50);
+    await assessAndMarkWorkingStyleEffect(cfg, AGENT_ID, 90);
+    expect(await assessAndMarkWorkingStyleEffect(cfg, AGENT_ID, 95)).toBeNull();
+  });
+
+  it("累计有效性统计供三阶自调使用", async () => {
+    await seedConservativeChange(50);
+    await assessAndMarkWorkingStyleEffect(cfg, AGENT_ID, 80);
+    const stats = await readWorkingStyleEffectStats(cfg, AGENT_ID);
+    expect(stats?.assessedCount).toBe(1);
+    expect(stats?.improvedCount).toBe(1);
+    expect(stats?.regressedCount).toBe(0);
+  });
+});
diff --git a/src/gateway/agent-growth/working-style-store.ts b/src/gateway/agent-growth/working-style-store.ts
new file mode 100644
index 0000000000..b508939016
--- /dev/null
+++ b/src/gateway/agent-growth/working-style-store.ts
@@ -0,0 +1,329 @@
+/**
+ * AgentGenome Working DNA 持久化（件事三：把 workingStyle 接成「行为改变」的实际写入）。
+ *
+ * 机器人：`{agentDir}/working-style.json`（agentDir 由 resolveAgentDir 解析），
+ * 与 growth-status.json 同级、同套低层读写（readJsonFile / writeJsonAtomic / 锁），保持无 collaboration 依赖。
+ *
+ * 写入触发：运营信号(operationalScore 的原始信号)经 deriveWorkingStyleDelta 确定性派生变更后落盘。
+ * 这是 Phase 2「任务→反馈→行为改变」闭环的行为端落点（读取/施加到实际提示词为后续步骤）。
+ */
+
+import fs from "node:fs/promises";
+import path from "node:path";
+import { resolveAgentDir } from "../../agents/agent-scope.js";
+import type { OpenClawConfig } from "../../config/config.js";
+import { createAsyncLock, readJsonFile, writeJsonAtomic } from "../../infra/json-files.js";
+import {
+  applyWorkingStyleDelta,
+  DEFAULT_WORKING_STYLE,
+  deriveWorkingStyleDelta,
+  evaluateWorkingStyleEffect,
+  type OperationalSignalsForStyle,
+  renderWorkingStyleInstructions,
+  sameWorkingStyleDelta,
+  type WorkingStyle,
+  type WorkingStyleEffectStatus,
+} from "./genome.js";
+
+export const WORKING_STYLE_FILENAME = "working-style.json";
+export const WORKING_STYLE_CHANGE_FILENAME = "working-style-change.json";
+export const WORKING_STYLE_SUPPRESSION_FILENAME = "working-style-suppression.json";
+export const WORKING_STYLE_EFFECT_STATS_FILENAME = "working-style-effect-stats.json";
+
+/**
+ * 行为改变有效性的累计统计（三阶自调用）。每次二阶评估得出结论(improved/regressed)时累加。
+ * 供 computeAdaptivityAdjustment 反哺 operationalScore。
+ */
+export type WorkingStyleEffectStats = {
+  improvedCount: number;
+  regressedCount: number;
+  assessedCount: number;
+  sumDeltaScore: number;
+  updatedAtMs: number;
+};
+
+/**
+ * 最近一次 Working DNA 变更记录（二阶反馈用）。记录变更时的基线实战分与被覆盖的旧值(previousValues)，
+ * 供后续 recompute 对比评估、并在判定回归时自动回滚。
+ * assessedAtMs 为 null 表示尚未评估；一旦得出结论即写入 effectStatus/deltaScore 并置 assessedAtMs。
+ */
+export type WorkingStyleChangeRecord = {
+  changedAtMs: number;
+  baselineOperationalScore: number | null;
+  appliedDelta: Partial<WorkingStyle>;
+  /** 变更前被覆盖字段的旧值（回滚目标）。 */
+  previousValues?: Partial<WorkingStyle>;
+  assessedAtMs: number | null;
+  effectStatus?: WorkingStyleEffectStatus;
+  deltaScore?: number | null;
+  /** 是否因判定回归而已自动回滚。 */
+  rolledBack?: boolean;
+};
+
+/**
+ * 振荡抑制：记录最近一次因回归被回滚的 delta。相同 delta 在被抑制期间不再重复应用
+ * （避免"应用→回归→回滚→再应用"死循环）。当信号产出不同的 delta 时自动解除。
+ */
+export type WorkingStyleSuppression = {
+  suppressedDelta: Partial<WorkingStyle>;
+  suppressedAtMs: number;
+};
+
+/** 解析机器人 working-style.json 路径。 */
+export function resolveRobotWorkingStylePath(cfg: OpenClawConfig, agentId: string): string {
+  return path.join(resolveAgentDir(cfg, agentId), WORKING_STYLE_FILENAME);
+}
+
+const lock = createAsyncLock();
+
+/** 读取机器人 WorkingStyle；不存在返回 null。 */
+export async function readRobotWorkingStyle(
+  cfg: OpenClawConfig,
+  agentId: string,
+): Promise<WorkingStyle | null> {
+  return await readJsonFile<WorkingStyle>(resolveRobotWorkingStylePath(cfg, agentId));
+}
+
+/** 读取机器人 WorkingStyle；不存在返回默认 DNA（补齐缺失字段，兼容旧文件）。 */
+export async function readRobotWorkingStyleOrDefault(
+  cfg: OpenClawConfig,
+  agentId: string,
+): Promise<WorkingStyle> {
+  const stored = await readRobotWorkingStyle(cfg, agentId);
+  return stored ? { ...DEFAULT_WORKING_STYLE, ...stored } : { ...DEFAULT_WORKING_STYLE };
+}
+
+/** 原子写入机器人 WorkingStyle。 */
+export async function writeRobotWorkingStyle(
+  cfg: OpenClawConfig,
+  agentId: string,
+  style: WorkingStyle,
+): Promise<void> {
+  await writeJsonAtomic(resolveRobotWorkingStylePath(cfg, agentId), style);
+}
+
+/** 在锁内对机器人 WorkingStyle 做读改写（updater 返回 null 表示不写）。 */
+export async function updateRobotWorkingStyle(
+  cfg: OpenClawConfig,
+  agentId: string,
+  updater: (current: WorkingStyle) => WorkingStyle | null,
+): Promise<WorkingStyle | null> {
+  return await lock(async () => {
+    const current = await readRobotWorkingStyleOrDefault(cfg, agentId);
+    const next = updater(current);
+    if (next === null) {
+      return current;
+    }
+    await writeRobotWorkingStyle(cfg, agentId, next);
+    return next;
+  });
+}
+
+/** 解析机器人 working-style-change.json 路径。 */
+export function resolveRobotWorkingStyleChangePath(cfg: OpenClawConfig, agentId: string): string {
+  return path.join(resolveAgentDir(cfg, agentId), WORKING_STYLE_CHANGE_FILENAME);
+}
+
+/** 解析机器人 working-style-suppression.json 路径。 */
+export function resolveRobotWorkingStyleSuppressionPath(
+  cfg: OpenClawConfig,
+  agentId: string,
+): string {
+  return path.join(resolveAgentDir(cfg, agentId), WORKING_STYLE_SUPPRESSION_FILENAME);
+}
+
+/** 解析机器人 working-style-effect-stats.json 路径。 */
+export function resolveRobotWorkingStyleEffectStatsPath(
+  cfg: OpenClawConfig,
+  agentId: string,
+): string {
+  return path.join(resolveAgentDir(cfg, agentId), WORKING_STYLE_EFFECT_STATS_FILENAME);
+}
+
+/** 读取机器人行为改变有效性统计；无则 null。 */
+export async function readWorkingStyleEffectStats(
+  cfg: OpenClawConfig,
+  agentId: string,
+): Promise<WorkingStyleEffectStats | null> {
+  return await readJsonFile<WorkingStyleEffectStats>(
+    resolveRobotWorkingStyleEffectStatsPath(cfg, agentId),
+  );
+}
+
+const changeLock = createAsyncLock();
+
+async function clearSuppression(cfg: OpenClawConfig, agentId: string): Promise<void> {
+  await fs.rm(resolveRobotWorkingStyleSuppressionPath(cfg, agentId), { force: true });
+}
+
+/** 读取最近一次 Working DNA 变更记录；无则 null。 */
+export async function readWorkingStyleChange(
+  cfg: OpenClawConfig,
+  agentId: string,
+): Promise<WorkingStyleChangeRecord | null> {
+  return await readJsonFile<WorkingStyleChangeRecord>(
+    resolveRobotWorkingStyleChangePath(cfg, agentId),
+  );
+}
+
+/**
+ * 从运营信号确定性派生 Working DNA 变更并落盘（行为改变写入）。
+ * 无变更（空 delta）→ 不写，返回 null；有变更 → 合并写入，并记录一条变更记录（含基线实战分）供二阶反馈评估。
+ */
+export async function applyOperationalSignalsToWorkingStyle(
+  cfg: OpenClawConfig,
+  agentId: string,
+  signals: OperationalSignalsForStyle,
+  baselineOperationalScore?: number | null,
+): Promise<WorkingStyle | null> {
+  const delta = deriveWorkingStyleDelta(signals);
+  if (Object.keys(delta).length === 0) {
+    return null;
+  }
+  // 振荡抑制：与上次因回归被回滚的 delta 相同 → 跳过（已知有害；等信号变化产出不同 delta 再试）。
+  const suppression = await readJsonFile<WorkingStyleSuppression>(
+    resolveRobotWorkingStyleSuppressionPath(cfg, agentId),
+  );
+  if (suppression && sameWorkingStyleDelta(suppression.suppressedDelta, delta)) {
+    return null;
+  }
+  let didChange = false;
+  let previousValues: Partial<WorkingStyle> = {};
+  const result = await updateRobotWorkingStyle(cfg, agentId, (current) => {
+    const next = applyWorkingStyleDelta(current, delta);
+    // 仅在有实际变化时写（避免无谓落盘），并记录被覆盖字段的旧值供回滚。
+    const changedKeys = (Object.keys(delta) as Array<keyof WorkingStyle>).filter(
+      (key) => current[key] !== next[key],
+    );
+    didChange = changedKeys.length > 0;
+    if (didChange) {
+      previousValues = Object.fromEntries(
+        changedKeys.map((key) => [key, current[key]]),
+      ) as Partial<WorkingStyle>;
+    }
+    return didChange ? next : null;
+  });
+  if (didChange) {
+    // 记录变更 + 基线实战分 + 旧值（下次 recompute 据此评估效果；回归则回滚）。
+    await changeLock(async () => {
+      await writeJsonAtomic(resolveRobotWorkingStyleChangePath(cfg, agentId), {
+        changedAtMs: Date.now(),
+        baselineOperationalScore:
+          typeof baselineOperationalScore === "number" ? baselineOperationalScore : null,
+        appliedDelta: delta,
+        previousValues,
+        assessedAtMs: null,
+      } satisfies WorkingStyleChangeRecord);
+      // 应用了不同于被抑制的 delta → 解除抑制。
+      await clearSuppression(cfg, agentId);
+    });
+    return result;
+  }
+  return null;
+}
+
+/**
+ * 二阶反馈：评估上一次 Working DNA 变更的效果（基线实战分 vs 当前实战分）。
+ * 仅在存在未评估的变更记录、且能得出结论(improved/regressed)时标记为已评估并返回 `newlyAssessed:true`；
+ * 结论不明（inconclusive）则保留记录待后续评估。locked，避免与写入竞争。
+ */
+export async function assessAndMarkWorkingStyleEffect(
+  cfg: OpenClawConfig,
+  agentId: string,
+  currentOperationalScore: number | null,
+): Promise<{
+  status: WorkingStyleEffectStatus;
+  deltaScore: number | null;
+  newlyAssessed: boolean;
+  rolledBack: boolean;
+} | null> {
+  return await changeLock(async () => {
+    const filePath = resolveRobotWorkingStyleChangePath(cfg, agentId);
+    const record = await readJsonFile<WorkingStyleChangeRecord>(filePath);
+    if (!record || record.assessedAtMs !== null) {
+      return null;
+    }
+    const effect = evaluateWorkingStyleEffect(
+      record.baselineOperationalScore,
+      currentOperationalScore,
+    );
+    if (effect.status === "inconclusive") {
+      // 保留未评估状态，等待后续 recompute 有更充分的实战数据。
+      return {
+        status: effect.status,
+        deltaScore: effect.deltaScore,
+        newlyAssessed: false,
+        rolledBack: false,
+      };
+    }
+    let rolledBack = false;
+    if (
+      effect.status === "regressed" &&
+      record.previousValues &&
+      Object.keys(record.previousValues).length > 0
+    ) {
+      // 自动回滚：恢复变更前的值（此前表现更好），并抑制重复应用同一 delta（防振荡）。
+      // improved → 保留变更（即"强化"：已应用的更优行为得以保留，无需额外动作）。
+      await updateRobotWorkingStyle(cfg, agentId, (current) =>
+        applyWorkingStyleDelta(current, record.previousValues ?? {}),
+      );
+      await writeJsonAtomic(resolveRobotWorkingStyleSuppressionPath(cfg, agentId), {
+        suppressedDelta: record.appliedDelta,
+        suppressedAtMs: Date.now(),
+      } satisfies WorkingStyleSuppression);
+      rolledBack = true;
+    }
+    await writeJsonAtomic(filePath, {
+      ...record,
+      assessedAtMs: Date.now(),
+      effectStatus: effect.status,
+      deltaScore: effect.deltaScore,
+      rolledBack,
+    } satisfies WorkingStyleChangeRecord);
+    // 三阶自调：累计有效性统计（供 computeAdaptivityAdjustment 反哺 operationalScore）。
+    const statsPath = resolveRobotWorkingStyleEffectStatsPath(cfg, agentId);
+    const stats = (await readJsonFile<WorkingStyleEffectStats>(statsPath)) ?? {
+      improvedCount: 0,
+      regressedCount: 0,
+      assessedCount: 0,
+      sumDeltaScore: 0,
+      updatedAtMs: 0,
+    };
+    stats.assessedCount += 1;
+    if (effect.status === "improved") {
+      stats.improvedCount += 1;
+    } else if (effect.status === "regressed") {
+      stats.regressedCount += 1;
+    }
+    stats.sumDeltaScore += effect.deltaScore ?? 0;
+    stats.updatedAtMs = Date.now();
+    await writeJsonAtomic(statsPath, stats satisfies WorkingStyleEffectStats);
+    return {
+      status: effect.status,
+      deltaScore: effect.deltaScore,
+      newlyAssessed: true,
+      rolledBack,
+    };
+  });
+}
+
+/**
+ * 读取机器人已学习的 Working DNA 并渲染为系统提示词指令。
+ * 仅当已持久化 `working-style.json`（即真的发生过行为改变）时返回文本；否则返回 undefined，
+ * 调用方据此跳过注入 —— 未学习过的 agent 保持原有行为（向后兼容）。
+ */
+export async function resolveWorkingStyleInstructions(
+  cfg: OpenClawConfig,
+  agentId: string,
+): Promise<string | undefined> {
+  const id = agentId.trim();
+  if (!id) {
+    return undefined;
+  }
+  const stored = await readRobotWorkingStyle(cfg, id);
+  if (!stored) {
+    return undefined;
+  }
+  const rendered = renderWorkingStyleInstructions({ ...DEFAULT_WORKING_STYLE, ...stored }).trim();
+  return rendered.length > 0 ? rendered : undefined;
+}
