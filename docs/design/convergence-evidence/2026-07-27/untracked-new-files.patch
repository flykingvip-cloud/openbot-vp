+import { describe, expect, it } from "vitest";
+import {
+  applyWorkingStyleDelta,
+  composeAgentGenome,
+  DEFAULT_WORKING_STYLE,
+  deriveWorkingStyleDelta,
+  evaluateWorkingStyleEffect,
+  renderWorkingStyleInstructions,
+  sameWorkingStyleDelta,
+} from "./genome.js";
+
+describe("composeAgentGenome", () => {
+  it("composes defaults from minimal input", () => {
+    const genome = composeAgentGenome({ agentId: "a1", nowMs: 1000 });
+    expect(genome.agentId).toBe("a1");
+    expect(genome.identity).toEqual({});
+    expect(genome.habitsScore).toBe(0);
+    expect(genome.workingStyle).toEqual(DEFAULT_WORKING_STYLE);
+    expect(genome.learningAssetIds).toEqual([]);
+    expect(genome.composedAtMs).toBe(1000);
+  });
+
+  it("clamps habits score and overrides only provided working-style fields", () => {
+    const genome = composeAgentGenome({
+      agentId: "a1",
+      habitsScore: 140,
+      workingStyle: { outputFormat: "concise", riskPreference: "aggressive" },
+    });
+    expect(genome.habitsScore).toBe(100);
+    expect(genome.workingStyle.outputFormat).toBe("concise");
+    expect(genome.workingStyle.riskPreference).toBe("aggressive");
+    // unspecified fields keep defaults
+    expect(genome.workingStyle.decisionPreference).toBe(DEFAULT_WORKING_STYLE.decisionPreference);
+  });
+
+  it("dedupes and trims learning asset id references", () => {
+    const genome = composeAgentGenome({
+      agentId: "a1",
+      learningAssetIds: ["x", "x", " y ", "", "z"],
+    });
+    expect(genome.learningAssetIds).toEqual(["x", "y", "z"]);
+  });
+});
+
+describe("applyWorkingStyleDelta", () => {
+  it("merges only the fields present in the delta (behavior-change primitive)", () => {
+    const next = applyWorkingStyleDelta(DEFAULT_WORKING_STYLE, {
+      reportingCadence: "milestone",
+      communicationTone: "friendly",
+    });
+    expect(next.reportingCadence).toBe("milestone");
+    expect(next.communicationTone).toBe("friendly");
+    expect(next.outputFormat).toBe(DEFAULT_WORKING_STYLE.outputFormat);
+    // original is untouched (pure)
+    expect(DEFAULT_WORKING_STYLE.reportingCadence).toBe("on_completion");
+  });
+});
+
+describe("deriveWorkingStyleDelta (operational signals -> behavior change)", () => {
+  it("returns an empty delta when signals are neutral or absent", () => {
+    expect(deriveWorkingStyleDelta({})).toEqual({});
+    expect(deriveWorkingStyleDelta({ taskSuccessRate: 0.7, humanTakeoverRate: 0.2 })).toEqual({});
+  });
+
+  it("tightens oversight on high human takeover", () => {
+    expect(deriveWorkingStyleDelta({ humanTakeoverRate: 0.6 })).toEqual({
+      riskPreference: "conservative",
+      decisionPreference: "confirm_first",
+    });
+  });
+
+  it("loosens autonomy on low takeover + high success", () => {
+    expect(deriveWorkingStyleDelta({ humanTakeoverRate: 0.05, taskSuccessRate: 0.95 })).toEqual({
+      decisionPreference: "autonomous",
+    });
+  });
+
+  it("stays conservative on low success rate", () => {
+    expect(deriveWorkingStyleDelta({ taskSuccessRate: 0.4 })).toEqual({
+      riskPreference: "conservative",
+    });
+  });
+
+  it("composes with applyWorkingStyleDelta to produce a full working style", () => {
+    const delta = deriveWorkingStyleDelta({ humanTakeoverRate: 0.6 });
+    const next = applyWorkingStyleDelta(DEFAULT_WORKING_STYLE, delta);
+    expect(next.riskPreference).toBe("conservative");
+    expect(next.decisionPreference).toBe("confirm_first");
+    expect(next.outputFormat).toBe(DEFAULT_WORKING_STYLE.outputFormat);
+  });
+});
+
+describe("renderWorkingStyleInstructions (working DNA -> prompt directives)", () => {
+  it("renders actionable directives for a learned style and skips neutral defaults", () => {
+    const text = renderWorkingStyleInstructions({
+      outputFormat: "concise",
+      reportingCadence: "on_request",
+      decisionPreference: "autonomous",
+      riskPreference: "balanced", // neutral -> no directive
+      communicationTone: "neutral", // neutral -> no directive
+    });
+    expect(text).toContain("Apply your learned working style");
+    expect(text).toContain("concise");
+    expect(text).toContain("only when asked");
+    expect(text).toContain("autonomously");
+    // neutral middles produce no line
+    expect(text).not.toContain("conservative");
+    expect(text).not.toContain("friendly");
+    // three directive lines (outputFormat, reportingCadence, decisionPreference)
+    expect(text.split("\n").filter((l) => l.startsWith("- ")).length).toBe(3);
+  });
+
+  it("renders risk/tone directives when non-neutral", () => {
+    const text = renderWorkingStyleInstructions({
+      ...DEFAULT_WORKING_STYLE,
+      riskPreference: "conservative",
+      communicationTone: "friendly",
+    });
+    expect(text).toContain("conservative");
+    expect(text).toContain("friendly");
+  });
+});
+
+describe("evaluateWorkingStyleEffect (second-order feedback)", () => {
+  it("is inconclusive when a score is missing", () => {
+    expect(evaluateWorkingStyleEffect(null, 80)).toEqual({
+      status: "inconclusive",
+      deltaScore: null,
+    });
+    expect(evaluateWorkingStyleEffect(70, null)).toEqual({
+      status: "inconclusive",
+      deltaScore: null,
+    });
+  });
+
+  it("is inconclusive when the change is below the noise threshold", () => {
+    expect(evaluateWorkingStyleEffect(70, 73)).toEqual({ status: "inconclusive", deltaScore: 3 });
+  });
+
+  it("flags improvement when the score rose meaningfully", () => {
+    expect(evaluateWorkingStyleEffect(60, 80)).toEqual({ status: "improved", deltaScore: 20 });
+  });
+
+  it("flags regression when the score dropped meaningfully", () => {
+    expect(evaluateWorkingStyleEffect(80, 60)).toEqual({ status: "regressed", deltaScore: -20 });
+  });
+
+  it("honors a custom minDelta", () => {
+    expect(evaluateWorkingStyleEffect(70, 78, { minDelta: 10 })).toEqual({
+      status: "inconclusive",
+      deltaScore: 8,
+    });
+  });
+});
+
+describe("sameWorkingStyleDelta (oscillation suppression key)", () => {
+  it("treats identical deltas as equal (order-independent)", () => {
+    expect(
+      sameWorkingStyleDelta(
+        { riskPreference: "conservative", decisionPreference: "confirm_first" },
+        { decisionPreference: "confirm_first", riskPreference: "conservative" },
+      ),
+    ).toBe(true);
+  });
+
+  it("treats differing values or key sets as not equal", () => {
+    expect(
+      sameWorkingStyleDelta({ riskPreference: "conservative" }, { riskPreference: "aggressive" }),
+    ).toBe(false);
+    expect(
+      sameWorkingStyleDelta(
+        { riskPreference: "conservative" },
+        { riskPreference: "conservative", decisionPreference: "autonomous" },
+      ),
+    ).toBe(false);
+  });
+
+  it("treats two empty deltas as equal", () => {
+    expect(sameWorkingStyleDelta({}, {})).toBe(true);
+  });
+});
