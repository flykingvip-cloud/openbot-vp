@@ -0,0 +1,21 @@
+/**
+ * Structured errors for enterprise model governance RPCs / probes.
+ */
+
+import type { EnterpriseModelProbeCode } from "./types.js";
+
+export class EnterpriseModelError extends Error {
+  readonly code: EnterpriseModelProbeCode;
+  readonly retryable: boolean;
+
+  constructor(code: EnterpriseModelProbeCode, message: string, opts?: { retryable?: boolean }) {
+    super(message);
+    this.name = "EnterpriseModelError";
+    this.code = code;
+    this.retryable = opts?.retryable ?? false;
+  }
+}
+
+export function isEnterpriseModelError(error: unknown): error is EnterpriseModelError {
+  return error instanceof EnterpriseModelError;
+}
diff --git a/src/gateway/enterprise-model/probe.ts b/src/gateway/enterprise-model/probe.ts
new file mode 100644
index 0000000000..3c52ac9ecc
--- /dev/null
+++ b/src/gateway/enterprise-model/probe.ts
@@ -0,0 +1,205 @@
+/**
+ * Lightweight provider probes (list models / health) — no inference cost.
+ */
+
+import { EnterpriseModelError } from "./errors.js";
+import type {
+  EnterpriseModelCredentialSecret,
+  EnterpriseModelProbeCode,
+  EnterpriseModelProviderType,
+} from "./types.js";
+
+export type ProbeDiscoveredModel = {
+  upstreamModelId: string;
+  displayName?: string;
+};
+
+export type ProbeResult = {
+  ok: boolean;
+  code: EnterpriseModelProbeCode;
+  message: string;
+  discoveredModels: ProbeDiscoveredModel[];
+};
+
+export type ProbeConnectionInput = {
+  providerType: EnterpriseModelProviderType;
+  protocol: string;
+  baseUrl?: string;
+  secret: EnterpriseModelCredentialSecret;
+  /** Override fetch for tests. */
+  fetchImpl?: typeof fetch;
+  timeoutMs?: number;
+};
+
+function defaultBaseUrl(providerType: EnterpriseModelProviderType): string {
+  switch (providerType) {
+    case "anthropic":
+      return "https://api.anthropic.com";
+    case "openai":
+      return "https://api.openai.com/v1";
+    default:
+      return "";
+  }
+}
+
+function normalizeBaseUrl(raw: string): string {
+  return raw.trim().replace(/\/+$/, "");
+}
+
+function classifyHttpStatus(status: number): EnterpriseModelProbeCode {
+  if (status === 401 || status === 403) {
+    return "ENTERPRISE_MODEL_INVALID_CREDENTIAL";
+  }
+  if (status === 429) {
+    return "ENTERPRISE_MODEL_RATE_LIMITED";
+  }
+  if (status === 404) {
+    return "ENTERPRISE_MODEL_PROTOCOL_MISMATCH";
+  }
+  if (status >= 500) {
+    return "ENTERPRISE_MODEL_NETWORK_UNREACHABLE";
+  }
+  return "ENTERPRISE_MODEL_PROTOCOL_MISMATCH";
+}
+
+function classifyNetworkError(error: unknown): EnterpriseModelProbeCode {
+  const message =
+    error instanceof Error ? error.message.toLowerCase() : String(error).toLowerCase();
+  if (message.includes("abort") || message.includes("timeout")) {
+    return "ENTERPRISE_MODEL_TIMEOUT";
+  }
+  return "ENTERPRISE_MODEL_NETWORK_UNREACHABLE";
+}
+
+function parseOpenAiModels(payload: unknown): ProbeDiscoveredModel[] {
+  if (!payload || typeof payload !== "object") {
+    return [];
+  }
+  const data = (payload as { data?: unknown }).data;
+  if (!Array.isArray(data)) {
+    return [];
+  }
+  const out: ProbeDiscoveredModel[] = [];
+  for (const row of data) {
+    if (!row || typeof row !== "object") {
+      continue;
+    }
+    const id =
+      typeof (row as { id?: unknown }).id === "string" ? (row as { id: string }).id.trim() : "";
+    if (!id) {
+      continue;
+    }
+    out.push({ upstreamModelId: id, displayName: id });
+  }
+  return out;
+}
+
+/**
+ * Probe provider without charging inference: prefer GET /models (OpenAI-compatible)
+ * or Anthropic models list endpoint.
+ */
+export async function probeEnterpriseModelConnection(
+  input: ProbeConnectionInput,
+): Promise<ProbeResult> {
+  const apiKey = input.secret.apiKey?.trim();
+  if (!apiKey) {
+    return {
+      ok: false,
+      code: "ENTERPRISE_MODEL_INVALID_CREDENTIAL",
+      message: "apiKey required",
+      discoveredModels: [],
+    };
+  }
+
+  const base =
+    normalizeBaseUrl(input.baseUrl ?? "") || normalizeBaseUrl(defaultBaseUrl(input.providerType));
+  if (!base) {
+    return {
+      ok: false,
+      code: "ENTERPRISE_MODEL_INVALID_REQUEST",
+      message: "baseUrl required for this provider type",
+      discoveredModels: [],
+    };
+  }
+
+  const fetchImpl = input.fetchImpl ?? fetch;
+  const timeoutMs = input.timeoutMs ?? 15_000;
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), timeoutMs);
+
+  const isAnthropic = input.providerType === "anthropic" || input.protocol.includes("anthropic");
+  const url = isAnthropic
+    ? `${base}/v1/models`
+    : base.endsWith("/v1")
+      ? `${base}/models`
+      : `${base}/v1/models`;
+
+  const headers: Record<string, string> = {
+    Accept: "application/json",
+    ...input.secret.headers,
+  };
+  if (isAnthropic) {
+    headers["x-api-key"] = apiKey;
+    headers["anthropic-version"] = "2023-06-01";
+  } else {
+    headers.Authorization = `Bearer ${apiKey}`;
+  }
+
+  try {
+    const response = await fetchImpl(url, {
+      method: "GET",
+      headers,
+      signal: controller.signal,
+    });
+    if (!response.ok) {
+      const code = classifyHttpStatus(response.status);
+      return {
+        ok: false,
+        code,
+        message: `probe failed with HTTP ${response.status}`,
+        discoveredModels: [],
+      };
+    }
+    let payload: unknown;
+    try {
+      payload = await response.json();
+    } catch {
+      return {
+        ok: false,
+        code: "ENTERPRISE_MODEL_PROTOCOL_MISMATCH",
+        message: "response is not JSON",
+        discoveredModels: [],
+      };
+    }
+    const discoveredModels = parseOpenAiModels(payload);
+    return {
+      ok: true,
+      code: "OK",
+      message: `verified; discovered ${discoveredModels.length} models`,
+      discoveredModels,
+    };
+  } catch (error) {
+    const code = classifyNetworkError(error);
+    return {
+      ok: false,
+      code,
+      message: error instanceof Error ? error.message : String(error),
+      discoveredModels: [],
+    };
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+export async function probeOrThrow(input: ProbeConnectionInput): Promise<ProbeResult> {
+  const result = await probeEnterpriseModelConnection(input);
+  if (!result.ok) {
+    throw new EnterpriseModelError(result.code, result.message, {
+      retryable:
+        result.code === "ENTERPRISE_MODEL_TIMEOUT" ||
+        result.code === "ENTERPRISE_MODEL_NETWORK_UNREACHABLE" ||
+        result.code === "ENTERPRISE_MODEL_RATE_LIMITED",
+    });
+  }
+  return result;
+}
diff --git a/src/gateway/enterprise-model/connection-store.ts b/src/gateway/enterprise-model/connection-store.ts
new file mode 100644
index 0000000000..df6556641c
--- /dev/null
+++ b/src/gateway/enterprise-model/connection-store.ts
@@ -0,0 +1,249 @@
+/**
+ * Tenant-keyed enterprise model provider connection store.
+ * Spec: `.kiro/specs/enterprise-ai-model-governance/`
+ */
+
+import { randomUUID } from "node:crypto";
+import path from "node:path";
+import { createAsyncLock, readJsonFile, writeJsonAtomic } from "../../infra/json-files.js";
+import { CONFIG_DIR, resolveUserPath } from "../../utils.js";
+import { canonicalizeTenantId } from "../tenant-canonicalization.js";
+import { EnterpriseModelError } from "./errors.js";
+import { buildCredentialRef } from "./ids.js";
+import type {
+  EnterpriseModelConnectionStatus,
+  EnterpriseModelHealthStatus,
+  EnterpriseModelProbeCode,
+  EnterpriseModelProviderConnection,
+  EnterpriseModelProviderType,
+} from "./types.js";
+
+const STORE_VERSION = 1;
+
+type Store = {
+  version: number;
+  /** key = connectionId */
+  connections: Record<string, EnterpriseModelProviderConnection>;
+};
+
+function createEmptyStore(): Store {
+  return { version: STORE_VERSION, connections: {} };
+}
+
+export function resolveDefaultConnectionStorePath(): string {
+  return path.join(CONFIG_DIR, "openbot-enterprise-model-connections.json");
+}
+
+const withLock = createAsyncLock();
+
+async function loadStore(storePath?: string): Promise<Store> {
+  const resolvedPath = resolveUserPath(storePath?.trim() || resolveDefaultConnectionStorePath());
+  const parsed = await readJsonFile<Partial<Store>>(resolvedPath);
+  if (!parsed || typeof parsed.connections !== "object" || parsed.connections === null) {
+    return createEmptyStore();
+  }
+  return { version: STORE_VERSION, connections: parsed.connections };
+}
+
+async function saveStore(store: Store, storePath?: string): Promise<void> {
+  const resolvedPath = resolveUserPath(storePath?.trim() || resolveDefaultConnectionStorePath());
+  await writeJsonAtomic(resolvedPath, store);
+}
+
+const PROVIDER_TYPES: ReadonlySet<EnterpriseModelProviderType> = new Set([
+  "openai",
+  "anthropic",
+  "openai-compatible",
+  "custom",
+]);
+
+export function parseProviderType(raw: unknown): EnterpriseModelProviderType | null {
+  if (typeof raw !== "string") {
+    return null;
+  }
+  const value = raw.trim() as EnterpriseModelProviderType;
+  return PROVIDER_TYPES.has(value) ? value : null;
+}
+
+export async function listEnterpriseModelConnections(
+  tenantId: string,
+  storePath?: string,
+): Promise<EnterpriseModelProviderConnection[]> {
+  const canonical = canonicalizeTenantId(tenantId);
+  if (!canonical) {
+    return [];
+  }
+  const store = await loadStore(storePath);
+  return Object.values(store.connections)
+    .filter((row) => row.tenantId === canonical)
+    .toSorted((a, b) => a.displayName.localeCompare(b.displayName));
+}
+
+export async function getEnterpriseModelConnection(
+  tenantId: string,
+  connectionId: string,
+  storePath?: string,
+): Promise<EnterpriseModelProviderConnection | null> {
+  const canonical = canonicalizeTenantId(tenantId);
+  if (!canonical) {
+    return null;
+  }
+  const store = await loadStore(storePath);
+  const row = store.connections[connectionId];
+  if (!row || row.tenantId !== canonical) {
+    return null;
+  }
+  return row;
+}
+
+export async function createEnterpriseModelConnection(
+  input: {
+    tenantId: string;
+    providerType: EnterpriseModelProviderType;
+    displayName: string;
+    baseUrl?: string;
+    protocol?: string;
+    connectionId?: string;
+  },
+  storePath?: string,
+): Promise<EnterpriseModelProviderConnection> {
+  const canonical = canonicalizeTenantId(input.tenantId);
+  if (!canonical) {
+    throw new EnterpriseModelError("ENTERPRISE_MODEL_INVALID_REQUEST", "invalid tenantId");
+  }
+  const displayName = input.displayName.trim();
+  if (!displayName) {
+    throw new EnterpriseModelError("ENTERPRISE_MODEL_INVALID_REQUEST", "displayName required");
+  }
+  return withLock(async () => {
+    const store = await loadStore(storePath);
+    const connectionId = input.connectionId?.trim() || randomUUID();
+    if (store.connections[connectionId]) {
+      throw new EnterpriseModelError(
+        "ENTERPRISE_MODEL_INVALID_REQUEST",
+        "connectionId already exists",
+      );
+    }
+    const now = new Date().toISOString();
+    const record: EnterpriseModelProviderConnection = {
+      tenantId: canonical,
+      connectionId,
+      providerType: input.providerType,
+      displayName,
+      ...(input.baseUrl?.trim() ? { baseUrl: input.baseUrl.trim() } : {}),
+      protocol: input.protocol?.trim() || defaultProtocol(input.providerType),
+      credentialRef: buildCredentialRef(canonical, connectionId),
+      status: "draft",
+      healthStatus: "unchecked",
+      createdAt: now,
+      updatedAt: now,
+    };
+    store.connections[connectionId] = record;
+    await saveStore(store, storePath);
+    return record;
+  });
+}
+
+function defaultProtocol(providerType: EnterpriseModelProviderType): string {
+  if (providerType === "anthropic") {
+    return "anthropic-messages";
+  }
+  return "openai-completions";
+}
+
+export async function updateEnterpriseModelConnection(
+  input: {
+    tenantId: string;
+    connectionId: string;
+    displayName?: string;
+    baseUrl?: string | null;
+    protocol?: string;
+    status?: EnterpriseModelConnectionStatus;
+    healthStatus?: EnterpriseModelHealthStatus;
+    secretHint?: string;
+    lastVerifiedAt?: string;
+    lastVerificationResult?: EnterpriseModelProviderConnection["lastVerificationResult"];
+    disabledAt?: string | null;
+  },
+  storePath?: string,
+): Promise<EnterpriseModelProviderConnection> {
+  const canonical = canonicalizeTenantId(input.tenantId);
+  if (!canonical) {
+    throw new EnterpriseModelError("ENTERPRISE_MODEL_INVALID_REQUEST", "invalid tenantId");
+  }
+  return withLock(async () => {
+    const store = await loadStore(storePath);
+    const existing = store.connections[input.connectionId];
+    if (!existing || existing.tenantId !== canonical) {
+      throw new EnterpriseModelError("ENTERPRISE_MODEL_NOT_FOUND", "connection not found");
+    }
+    const next: EnterpriseModelProviderConnection = {
+      ...existing,
+      ...(input.displayName !== undefined ? { displayName: input.displayName.trim() } : {}),
+      ...(input.protocol !== undefined ? { protocol: input.protocol.trim() } : {}),
+      ...(input.status !== undefined ? { status: input.status } : {}),
+      ...(input.healthStatus !== undefined ? { healthStatus: input.healthStatus } : {}),
+      ...(input.secretHint !== undefined ? { secretHint: input.secretHint } : {}),
+      ...(input.lastVerifiedAt !== undefined ? { lastVerifiedAt: input.lastVerifiedAt } : {}),
+      ...(input.lastVerificationResult !== undefined
+        ? { lastVerificationResult: input.lastVerificationResult }
+        : {}),
+      updatedAt: new Date().toISOString(),
+    };
+    if (input.baseUrl === null) {
+      delete next.baseUrl;
+    } else if (typeof input.baseUrl === "string") {
+      next.baseUrl = input.baseUrl.trim();
+    }
+    if (input.disabledAt === null) {
+      delete next.disabledAt;
+    } else if (typeof input.disabledAt === "string") {
+      next.disabledAt = input.disabledAt;
+    }
+    store.connections[input.connectionId] = next;
+    await saveStore(store, storePath);
+    return next;
+  });
+}
+
+export async function deleteEnterpriseModelConnection(
+  tenantId: string,
+  connectionId: string,
+  storePath?: string,
+): Promise<EnterpriseModelProviderConnection> {
+  const canonical = canonicalizeTenantId(tenantId);
+  if (!canonical) {
+    throw new EnterpriseModelError("ENTERPRISE_MODEL_INVALID_REQUEST", "invalid tenantId");
+  }
+  return withLock(async () => {
+    const store = await loadStore(storePath);
+    const existing = store.connections[connectionId];
+    if (!existing || existing.tenantId !== canonical) {
+      throw new EnterpriseModelError("ENTERPRISE_MODEL_NOT_FOUND", "connection not found");
+    }
+    delete store.connections[connectionId];
+    await saveStore(store, storePath);
+    return existing;
+  });
+}
+
+export function mapProbeCodeToConnectionStatus(
+  code: EnterpriseModelProbeCode,
+): EnterpriseModelConnectionStatus {
+  switch (code) {
+    case "OK":
+      return "verified";
+    case "ENTERPRISE_MODEL_INVALID_CREDENTIAL":
+    case "ENTERPRISE_MODEL_FORBIDDEN":
+      return "invalid_credential";
+    case "ENTERPRISE_MODEL_NETWORK_UNREACHABLE":
+    case "ENTERPRISE_MODEL_TIMEOUT":
+      return "network_unreachable";
+    case "ENTERPRISE_MODEL_PROTOCOL_MISMATCH":
+      return "protocol_incompatible";
+    case "ENTERPRISE_MODEL_RATE_LIMITED":
+      return "rate_limited";
+    default:
+      return "invalid_credential";
+  }
+}
diff --git a/src/gateway/enterprise-model/types.ts b/src/gateway/enterprise-model/types.ts
new file mode 100644
index 0000000000..9d351d8f16
--- /dev/null
+++ b/src/gateway/enterprise-model/types.ts
@@ -0,0 +1,99 @@
+/**
+ * Enterprise AI model governance — domain types (BYOK connections + assets).
+ * Spec: `.kiro/specs/enterprise-ai-model-governance/`
+ */
+
+export type EnterpriseModelProviderType = "openai" | "anthropic" | "openai-compatible" | "custom";
+
+export type EnterpriseModelConnectionStatus =
+  | "draft"
+  | "credential_saved"
+  | "verifying"
+  | "verified"
+  | "models_discovered"
+  | "active"
+  | "invalid_credential"
+  | "network_unreachable"
+  | "protocol_incompatible"
+  | "rate_limited"
+  | "disabled";
+
+export type EnterpriseModelHealthStatus =
+  | "unknown"
+  | "healthy"
+  | "degraded"
+  | "unhealthy"
+  | "unchecked";
+
+export type EnterpriseModelProbeCode =
+  | "OK"
+  | "ENTERPRISE_MODEL_INVALID_CREDENTIAL"
+  | "ENTERPRISE_MODEL_NETWORK_UNREACHABLE"
+  | "ENTERPRISE_MODEL_TIMEOUT"
+  | "ENTERPRISE_MODEL_RATE_LIMITED"
+  | "ENTERPRISE_MODEL_PROTOCOL_MISMATCH"
+  | "ENTERPRISE_MODEL_MODEL_UNAVAILABLE"
+  | "ENTERPRISE_MODEL_FORBIDDEN"
+  | "ENTERPRISE_MODEL_NOT_FOUND"
+  | "ENTERPRISE_MODEL_DEPENDENCY_BLOCKED"
+  | "ENTERPRISE_MODEL_INVALID_REQUEST";
+
+export type EnterpriseModelProviderConnection = {
+  tenantId: string;
+  connectionId: string;
+  providerType: EnterpriseModelProviderType;
+  displayName: string;
+  baseUrl?: string;
+  /** Protocol hint, e.g. openai-completions / anthropic-messages. */
+  protocol: string;
+  credentialRef: string;
+  /** Desensitized hint only (e.g. …abcd). Never plaintext. */
+  secretHint?: string;
+  status: EnterpriseModelConnectionStatus;
+  healthStatus: EnterpriseModelHealthStatus;
+  lastVerifiedAt?: string;
+  lastVerificationResult?: {
+    code: EnterpriseModelProbeCode;
+    message: string;
+    discoveredModelCount?: number;
+  };
+  createdAt: string;
+  updatedAt: string;
+  disabledAt?: string;
+};
+
+export type EnterpriseModelAsset = {
+  tenantId: string;
+  assetId: string;
+  connectionId: string;
+  /** Tenant-isolated runtime id; never embeds raw tenant secrets for upstream. */
+  runtimeModelId: string;
+  upstreamModelId: string;
+  displayName: string;
+  source: "enterprise";
+  billingOwner: "enterprise";
+  tier?: string;
+  capabilities?: string[];
+  enabled: boolean;
+  healthStatus: EnterpriseModelHealthStatus;
+  contextWindow?: number;
+  /** Optional cost metadata (cents per 1k tokens, etc.). */
+  cost?: {
+    inputPer1kCents?: number;
+    outputPer1kCents?: number;
+    currency?: string;
+  };
+  createdAt: string;
+  updatedAt: string;
+};
+
+export type EnterpriseModelCredentialSecret = {
+  apiKey: string;
+  /** Optional extra headers (never logged). */
+  headers?: Record<string, string>;
+};
+
+export type EnterpriseModelPublicConnection = Omit<EnterpriseModelProviderConnection, never> & {
+  /** Always true/false from vault presence; never includes secret material. */
+  hasCredential: boolean;
+};
diff --git a/src/gateway/enterprise-model/credential-vault.ts b/src/gateway/enterprise-model/credential-vault.ts
new file mode 100644
index 0000000000..cd84e92771
--- /dev/null
+++ b/src/gateway/enterprise-model/credential-vault.ts
@@ -0,0 +1,168 @@
+/**
+ * Enterprise model connection credential vault (AES-256-GCM).
+ * Reuses the same envelope pattern as connector-credential-vault; does NOT invent crypto.
+ * Plaintext must never be logged or returned via list/get APIs.
+ */
+
+import { createCipheriv, createDecipheriv, randomBytes } from "node:crypto";
+import path from "node:path";
+import { createAsyncLock, readJsonFile, writeJsonAtomic } from "../../infra/json-files.js";
+import { CONFIG_DIR, resolveUserPath } from "../../utils.js";
+import {
+  deriveVaultKey,
+  resolveVaultKeyMaterialFromEnv,
+} from "../enterprise-data/connector-credential-vault-key.js";
+import type { EnterpriseModelCredentialSecret } from "./types.js";
+
+const VAULT_FILENAME = "openbot-enterprise-model-secrets.json";
+
+type EncryptedSecretEnvelope = {
+  v: 1;
+  alg: "aes-256-gcm";
+  iv: string;
+  tag: string;
+  ct: string;
+};
+
+type VaultFile = {
+  credentials: Record<string, EncryptedSecretEnvelope>;
+};
+
+const keyLock = createAsyncLock();
+const keyCache = new Map<string, Buffer>();
+
+export function resolveDefaultEnterpriseModelVaultPath(): string {
+  return path.join(CONFIG_DIR, VAULT_FILENAME);
+}
+
+function resolveVaultPath(customPath?: string): string {
+  return resolveUserPath(customPath?.trim() || resolveDefaultEnterpriseModelVaultPath());
+}
+
+function resolveKeyPath(vaultPath: string): string {
+  return `${vaultPath}.key`;
+}
+
+async function resolveVaultKey(vaultPath: string): Promise<Buffer> {
+  const envMaterial = await resolveVaultKeyMaterialFromEnv();
+  if (envMaterial) {
+    return deriveVaultKey(envMaterial.material);
+  }
+  const keyPath = resolveKeyPath(vaultPath);
+  const cached = keyCache.get(keyPath);
+  if (cached) {
+    return cached;
+  }
+  return keyLock(async () => {
+    const cachedInLock = keyCache.get(keyPath);
+    if (cachedInLock) {
+      return cachedInLock;
+    }
+    const existing = await readJsonFile<{ key: string }>(keyPath);
+    if (existing?.key) {
+      const decoded = Buffer.from(existing.key, "base64");
+      if (decoded.length === 32) {
+        keyCache.set(keyPath, decoded);
+        return decoded;
+      }
+    }
+    const generated = randomBytes(32);
+    await writeJsonAtomic(keyPath, { key: generated.toString("base64") }, { mode: 0o600 });
+    keyCache.set(keyPath, generated);
+    return generated;
+  });
+}
+
+function encryptSecret(
+  secret: EnterpriseModelCredentialSecret,
+  key: Buffer,
+): EncryptedSecretEnvelope {
+  const iv = randomBytes(12);
+  const cipher = createCipheriv("aes-256-gcm", key, iv);
+  const ciphertext = Buffer.concat([cipher.update(JSON.stringify(secret), "utf8"), cipher.final()]);
+  return {
+    v: 1,
+    alg: "aes-256-gcm",
+    iv: iv.toString("base64"),
+    tag: cipher.getAuthTag().toString("base64"),
+    ct: ciphertext.toString("base64"),
+  };
+}
+
+function decryptSecret(
+  envelope: EncryptedSecretEnvelope,
+  key: Buffer,
+): EnterpriseModelCredentialSecret {
+  const decipher = createDecipheriv("aes-256-gcm", key, Buffer.from(envelope.iv, "base64"));
+  decipher.setAuthTag(Buffer.from(envelope.tag, "base64"));
+  const plaintext = Buffer.concat([
+    decipher.update(Buffer.from(envelope.ct, "base64")),
+    decipher.final(),
+  ]);
+  return JSON.parse(plaintext.toString("utf8")) as EnterpriseModelCredentialSecret;
+}
+
+export async function loadEnterpriseModelSecret(
+  credentialRef: string,
+  vaultPath?: string,
+): Promise<EnterpriseModelCredentialSecret | null> {
+  const resolved = resolveVaultPath(vaultPath);
+  const file = await readJsonFile<VaultFile>(resolved);
+  const stored = file?.credentials?.[credentialRef];
+  if (!stored || stored.alg !== "aes-256-gcm") {
+    return null;
+  }
+  try {
+    const key = await resolveVaultKey(resolved);
+    return decryptSecret(stored, key);
+  } catch {
+    return null;
+  }
+}
+
+export async function saveEnterpriseModelSecret(
+  credentialRef: string,
+  secret: EnterpriseModelCredentialSecret,
+  vaultPath?: string,
+): Promise<void> {
+  const resolved = resolveVaultPath(vaultPath);
+  const key = await resolveVaultKey(resolved);
+  const file = (await readJsonFile<VaultFile>(resolved)) ?? { credentials: {} };
+  file.credentials[credentialRef] = encryptSecret(secret, key);
+  await writeJsonAtomic(resolved, file, { mode: 0o600 });
+}
+
+export async function deleteEnterpriseModelSecret(
+  credentialRef: string,
+  vaultPath?: string,
+): Promise<void> {
+  const resolved = resolveVaultPath(vaultPath);
+  const file = await readJsonFile<VaultFile>(resolved);
+  if (!file?.credentials?.[credentialRef]) {
+    return;
+  }
+  delete file.credentials[credentialRef];
+  await writeJsonAtomic(resolved, file, { mode: 0o600 });
+}
+
+export async function hasEnterpriseModelSecret(
+  credentialRef: string,
+  vaultPath?: string,
+): Promise<boolean> {
+  const resolved = resolveVaultPath(vaultPath);
+  const file = await readJsonFile<VaultFile>(resolved);
+  return Boolean(file?.credentials?.[credentialRef]);
+}
+
+export function buildSecretHint(apiKey: string): string {
+  const trimmed = apiKey.trim();
+  if (trimmed.length <= 4) {
+    return "****";
+  }
+  return `…${trimmed.slice(-4)}`;
+}
+
+/** Test helper: clear in-memory key cache between vault path switches. */
+export function __resetEnterpriseModelVaultKeyCacheForTest(): void {
+  keyCache.clear();
+}
