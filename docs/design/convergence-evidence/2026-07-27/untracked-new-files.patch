index 0000000000..515a95ddf9
--- /dev/null
+++ b/src/auto-reply/reply/learning-recall.ts
@@ -0,0 +1,272 @@
+/**
+ * 学习资产回流（recall）—— 把已晋升的学习资产真正读回到系统提示词。
+ *
+ * 背景：`capsule → projection → asset` 的写入链路早已打通，但读回侧只提取
+ * `abstractedContent.capabilities` / `metadata.skills`（能力名字符串），而写入侧从不
+ * 产出这两个键，于是每一条经验都"写得进、读不出"——教训永远不会回到行为里。
+ *
+ * 本模块补上真正的读回：
+ *  - 渲染 `lesson` 正文（不是能力名）进提示词；
+ *  - 记录**复用次数**（被注入提示词才算复用），为复用阈值策展提供唯一可信口径。
+ */
+
+import type { AgentLearningAsset } from "@openbot/collaboration-core";
+import {
+  createWorkspaceCollaborationStores,
+  resolveGroupStoreFilePath,
+} from "../../gateway/collaboration-learning/shared.js";
+import { logVerbose } from "../../globals.js";
+import { withFileLock } from "../../infra/file-lock.js";
+import { createAsyncLock } from "../../infra/json-files.js";
+
+/** 单条可复述的经验。 */
+export type LearningRecallEntry = {
+  assetId: string;
+  assetType: NonNullable<AgentLearningAsset["assetType"]>;
+  /** 人类可读的一句话教训（已由晋升侧构造）。 */
+  lesson: string;
+  confidence: NonNullable<AgentLearningAsset["confidence"]>;
+  reuseCount: number;
+  isAntiPattern: boolean;
+};
+
+export type LearningRecall = {
+  capabilities: string[];
+  lessons: LearningRecallEntry[];
+};
+
+export const EMPTY_LEARNING_RECALL: LearningRecall = { capabilities: [], lessons: [] };
+
+/** 单次注入的教训条数上限（控制提示词膨胀）。 */
+export const LEARNING_RECALL_LIMIT = 5;
+
+export const LEARNING_ASSETS_FILENAME = "learning-assets.json";
+
+/**
+ * 学习资产文件锁的重试/失效参数（对齐仓库既有 store 的写锁惯例）。
+ * 复用记账与策展都是毫秒级小写，退避窗口取得比 auth/pairing 更短。
+ */
+const LEARNING_ASSET_LOCK_OPTIONS = {
+  retries: {
+    retries: 8,
+    factor: 2,
+    minTimeout: 25,
+    maxTimeout: 2_000,
+    randomize: true,
+  },
+  stale: 15_000,
+} as const;
+
+/** 进程内串行锁，按作用域隔离（不同作用域是不同文件，互不影响）。 */
+const inProcessLocks = new Map<string, ReturnType<typeof createAsyncLock>>();
+
+function resolveInProcessLock(scopeId: string): ReturnType<typeof createAsyncLock> {
+  const existing = inProcessLocks.get(scopeId);
+  if (existing) {
+    return existing;
+  }
+  const created = createAsyncLock();
+  inProcessLocks.set(scopeId, created);
+  return created;
+}
+
+/**
+ * 学习资产文件的写序列化锁（**进程内 + 跨进程双层**）。
+ *
+ * `learning-assets.json` 的更新都是「读 → 改 → 整体写回」，底层适配器只保证单次写
+ * 原子，不保证读改写原子。未加锁会丢复用计数，更糟的是策展的 `curatedSkillId` 幂等
+ * 标记会被覆盖，导致同一簇重复生成技能草稿。复用记账与策展共用同一把锁，否则两者
+ * 之间仍会交错。
+ *
+ * 为什么必须两层：`withFileLock` 在同一进程内是**可重入**的（按路径引用计数，第二个
+ * 并发调用会直接放行），所以它只解决跨进程互斥；进程内互斥仍要靠 `createAsyncLock`。
+ * 多个 gateway 实例共享同一 workspace 时，外层文件锁保证互斥；锁文件带 pid + 时间戳，
+ * 持有者进程消失或超时即判定为 stale 自动接管，不会因崩溃留下死锁。
+ */
+export function withLearningAssetLock<T>(scopeId: string, fn: () => Promise<T>): Promise<T> {
+  const normalizedScope = scopeId.trim();
+  return resolveInProcessLock(normalizedScope)(async () => {
+    const { groupRootDir } = createWorkspaceCollaborationStores();
+    const filePath = resolveGroupStoreFilePath({
+      groupRootDir,
+      groupId: normalizedScope,
+      filename: LEARNING_ASSETS_FILENAME,
+    });
+    return await withFileLock(filePath, LEARNING_ASSET_LOCK_OPTIONS, fn);
+  });
+}
+
+/**
+ * 非协作会话（单聊）的伪群作用域。
+ *
+ * 学习存储是按 groupId 分片的；单聊没有 groupId，若不给个稳定作用域，单聊里的
+ * 失败经验就完全无处落盘，也永远回不来。
+ */
+export function resolvePersonalLearningScopeId(agentId: string): string {
+  return `agent:${agentId.trim()}`;
+}
+
+function readStringList(value: unknown): string[] {
+  return Array.isArray(value)
+    ? value
+        .filter((entry): entry is string => typeof entry === "string")
+        .map((entry) => entry.trim())
+        .filter(Boolean)
+    : [];
+}
+
+function readText(value: unknown): string | null {
+  return typeof value === "string" && value.trim() ? value.trim() : null;
+}
+
+export function extractCapabilitiesFromAsset(asset: AgentLearningAsset): string[] {
+  return [
+    ...new Set([
+      ...readStringList(asset.abstractedContent?.capabilities),
+      ...readStringList(asset.metadata?.skills),
+    ]),
+  ];
+}
+
+/** 提取教训正文；兼容 lesson 缺失的历史资产（回落 title/summary）。 */
+export function extractLessonFromAsset(asset: AgentLearningAsset): string | null {
+  const content = asset.abstractedContent ?? {};
+  const lesson = readText(content.lesson);
+  if (lesson) {
+    return lesson;
+  }
+  const title = readText(content.title);
+  const summary = readText(content.summary);
+  const parts = [...new Set([title, summary].filter((part): part is string => Boolean(part)))];
+  return parts.length > 0 ? parts.join(" — ") : null;
+}
+
+function isActive(asset: AgentLearningAsset): boolean {
+  return asset.status === undefined || asset.status === "active";
+}
+
+const CONFIDENCE_RANK: Record<string, number> = { high: 3, medium: 2, low: 1 };
+
+/** 排序：高置信 → 高复用 → 新在前。纯函数，便于单测。 */
+export function rankLearningAssets(assets: AgentLearningAsset[]): AgentLearningAsset[] {
+  return [...assets].toSorted((left, right) => {
+    const confidence =
+      (CONFIDENCE_RANK[right.confidence ?? "low"] ?? 0) -
+      (CONFIDENCE_RANK[left.confidence ?? "low"] ?? 0);
+    if (confidence !== 0) {
+      return confidence;
+    }
+    const reuse = (right.reuseCount ?? 0) - (left.reuseCount ?? 0);
+    if (reuse !== 0) {
+      return reuse;
+    }
+    return (right.updatedAt ?? 0) - (left.updatedAt ?? 0);
+  });
+}
+
+/** 由资产列表构造 recall 载荷（纯函数）。 */
+export function buildLearningRecall(
+  assets: AgentLearningAsset[],
+  limit = LEARNING_RECALL_LIMIT,
+): LearningRecall {
+  const active = assets.filter(isActive);
+  const capabilities = [...new Set(active.flatMap(extractCapabilitiesFromAsset))];
+  const lessons: LearningRecallEntry[] = [];
+  const seenLessons = new Set<string>();
+  for (const asset of rankLearningAssets(active)) {
+    const lesson = extractLessonFromAsset(asset);
+    if (!lesson || seenLessons.has(lesson)) {
+      continue;
+    }
+    seenLessons.add(lesson);
+    lessons.push({
+      assetId: asset.assetId,
+      assetType: asset.assetType ?? "lesson",
+      lesson,
+      confidence: asset.confidence ?? "low",
+      reuseCount: asset.reuseCount ?? 0,
+      isAntiPattern: asset.abstractedContent?.capsuleType === "anti_pattern",
+    });
+    if (lessons.length >= limit) {
+      break;
+    }
+  }
+  return { capabilities, lessons };
+}
+
+/** 读取某个 bot 在某个作用域下可复用的学习资产。 */
+export async function readLearningRecall(params: {
+  scopeId: string;
+  botId: string;
+  limit?: number;
+}): Promise<LearningRecall> {
+  const scopeId = params.scopeId.trim();
+  const botId = params.botId.trim();
+  if (!scopeId || !botId) {
+    return EMPTY_LEARNING_RECALL;
+  }
+  const { learningStorage } = createWorkspaceCollaborationStores();
+  const assets = await learningStorage.readLearningAssets(scopeId, botId);
+  return buildLearningRecall(assets, params.limit ?? LEARNING_RECALL_LIMIT);
+}
+
+/**
+ * 记录复用：把注入过的资产 `reuseCount += 1`。
+ *
+ * 复用 = **真的进了提示词**，而不是被创建或被查看。这是阈值策展的计数口径。
+ */
+export async function recordLearningReuse(params: {
+  scopeId: string;
+  assetIds: string[];
+  atMs?: number;
+}): Promise<void> {
+  const targets = new Set(params.assetIds.map((id) => id.trim()).filter(Boolean));
+  if (targets.size === 0) {
+    return;
+  }
+  await withLearningAssetLock(params.scopeId, async () => {
+    const { learningStorage } = createWorkspaceCollaborationStores();
+    const assets = await learningStorage.readLearningAssets(params.scopeId);
+    if (assets.length === 0) {
+      return;
+    }
+    const now = params.atMs ?? Date.now();
+    let changed = false;
+    const next = assets.map((asset) => {
+      if (!targets.has(asset.assetId)) {
+        return asset;
+      }
+      changed = true;
+      return {
+        ...asset,
+        reuseCount: (asset.reuseCount ?? 0) + 1,
+        lastReusedAt: now,
+        updatedAt: now,
+      } satisfies AgentLearningAsset;
+    });
+    if (!changed) {
+      return;
+    }
+    await learningStorage.writeLearningAssets(params.scopeId, next);
+  });
+}
+
+/**
+ * 永不 reject 的复用计数（提示词组装路径上不能因此失败）。
+ *
+ * `onRecorded` 在计数**落盘之后**触发，供复用阈值策展使用——必须在写盘后才查阈值，
+ * 否则本次复用没算进去，会永远差一次才毕业。
+ */
+export function recordLearningReuseSafely(params: {
+  scopeId: string;
+  assetIds: string[];
+  onRecorded?: () => void;
+}): void {
+  void recordLearningReuse({ scopeId: params.scopeId, assetIds: params.assetIds })
+    .then(() => {
+      params.onRecorded?.();
+    })
+    .catch((err) => {
+      logVerbose(`learning reuse accounting failed: ${String(err)}`);
+    });
+}
diff --git a/src/auto-reply/reply/learning-skill-curation.ts b/src/auto-reply/reply/learning-skill-curation.ts
new file mode 100644
index 0000000000..d90e32cae9
--- /dev/null
+++ b/src/auto-reply/reply/learning-skill-curation.ts
@@ -0,0 +1,141 @@
+/**
+ * 复用阈值策展的落地：学习资产 → `draft` 技能 → 等人工审核。
+ *
+ * 触发时机：一次复用记账之后（"刚刚又用了一次"是最自然的毕业检查点）。
+ * 幂等：策展后把 `curatedSkillId` 写回参与的资产，同一簇不会重复生成技能。
+ */
+
+import type { AgentLearningAsset } from "@openbot/collaboration-core";
+import {
+  buildSkillDraftProfile,
+  deriveSkillDraftCandidates,
+  type SkillDraftCandidate,
+} from "../../gateway/agent-growth/skill-draft-curation.js";
+import { createWorkspaceCollaborationStores } from "../../gateway/collaboration-learning/shared.js";
+import { saveSkillAsset } from "../../gateway/skill-lifecycle-store.js";
+import { logVerbose } from "../../globals.js";
+import { withLearningAssetLock } from "./learning-recall.js";
+
+export type CuratedSkillDraft = {
+  skillId: string;
+  clusterKey: string;
+  assetIds: string[];
+  trigger: SkillDraftCandidate["trigger"];
+  totalReuse: number;
+  occurrences: number;
+};
+
+export type CurateLearningSkillDraftsParams = {
+  scopeId: string;
+  botId?: string;
+  reuseThreshold?: number;
+  occurrenceThreshold?: number;
+  atMs?: number;
+};
+
+/**
+ * 扫描某作用域下的学习资产，把达到复用阈值的经验沉淀为技能草稿。
+ *
+ * 返回本次新生成的草稿；无候选时返回空数组且不写盘。
+ */
+export async function curateLearningSkillDrafts(
+  params: CurateLearningSkillDraftsParams,
+): Promise<CuratedSkillDraft[]> {
+  const scopeId = params.scopeId.trim();
+  if (!scopeId) {
+    return [];
+  }
+  // 与复用记账共用同一把锁：策展也是读改写，且要靠 curatedSkillId 保证幂等。
+  return withLearningAssetLock(scopeId, () =>
+    curateLearningSkillDraftsLocked({ ...params, scopeId }),
+  );
+}
+
+async function curateLearningSkillDraftsLocked(
+  params: CurateLearningSkillDraftsParams & { scopeId: string },
+): Promise<CuratedSkillDraft[]> {
+  const scopeId = params.scopeId;
+  const { learningStorage } = createWorkspaceCollaborationStores();
+  const allAssets = await learningStorage.readLearningAssets(scopeId);
+  const botId = params.botId?.trim();
+  const scopedAssets = botId ? allAssets.filter((asset) => asset.botId === botId) : allAssets;
+
+  const candidates = deriveSkillDraftCandidates(scopedAssets, {
+    ...(params.reuseThreshold !== undefined ? { reuseThreshold: params.reuseThreshold } : {}),
+    ...(params.occurrenceThreshold !== undefined
+      ? { occurrenceThreshold: params.occurrenceThreshold }
+      : {}),
+  });
+  if (candidates.length === 0) {
+    return [];
+  }
+
+  const now = params.atMs ?? Date.now();
+  const curated: CuratedSkillDraft[] = [];
+  const curatedByAssetId = new Map<string, string>();
+
+  for (const candidate of candidates) {
+    try {
+      // draft 状态：只沉淀，不发布。审核走既有 skill lifecycle（submit → reviewing → approved）。
+      const { skillId } = saveSkillAsset({
+        sourceAgentId: candidate.botId,
+        contextId: `learning:${scopeId}`,
+        lifecycle: "draft",
+        profile: buildSkillDraftProfile(candidate),
+        runtimeDefinition: {
+          prompts: [candidate.lesson],
+          tools: candidate.capabilities,
+        },
+      });
+      curated.push({
+        skillId,
+        clusterKey: candidate.clusterKey,
+        assetIds: candidate.assetIds,
+        trigger: candidate.trigger,
+        totalReuse: candidate.totalReuse,
+        occurrences: candidate.occurrences,
+      });
+      for (const assetId of candidate.assetIds) {
+        curatedByAssetId.set(assetId, skillId);
+      }
+    } catch (err) {
+      logVerbose(`skill draft curation failed: cluster=${candidate.clusterKey} ${String(err)}`);
+    }
+  }
+
+  if (curatedByAssetId.size === 0) {
+    return curated;
+  }
+
+  // 幂等标记：写回 curatedSkillId，避免下一次复用又生成一份重复草稿。
+  const next = allAssets.map((asset) => {
+    const skillId = curatedByAssetId.get(asset.assetId);
+    if (!skillId) {
+      return asset;
+    }
+    return {
+      ...asset,
+      curatedSkillId: skillId,
+      curatedAt: now,
+      updatedAt: now,
+    } satisfies AgentLearningAsset;
+  });
+  await learningStorage.writeLearningAssets(scopeId, next);
+  return curated;
+}
+
+/** 永不 reject 的包装，供提示词组装后 fire-and-forget 调用。 */
+export function curateLearningSkillDraftsSafely(params: CurateLearningSkillDraftsParams): void {
+  void curateLearningSkillDrafts(params)
+    .then((drafts) => {
+      for (const draft of drafts) {
+        logVerbose(
+          `skill draft curated: skill=${draft.skillId} cluster=${draft.clusterKey} ` +
+            `trigger=${draft.trigger} reuse=${draft.totalReuse} occurrences=${draft.occurrences}`,
+        );
+      }
+    })
+    .catch((err) => {
+      logVerbose(`skill draft curation failed: ${String(err)}`);
+    });
+}
diff --git a/src/gateway/agent-growth/experience-capsule.test.ts b/src/gateway/agent-growth/experience-capsule.test.ts
new file mode 100644
index 0000000000..faae931e99
--- /dev/null
+++ b/src/gateway/agent-growth/experience-capsule.test.ts
@@ -0,0 +1,142 @@
+import { describe, expect, it } from "vitest";
+import { buildExperienceLesson, deriveCandidateCapsule } from "./experience-capsule.js";
+
+describe("deriveCandidateCapsule", () => {
+  it("produces a candidate capsule that is NOT self-approved", () => {
+    const capsule = deriveCandidateCapsule({
+      trigger: "task_failure",
+      scopeId: "agent:daibai",
+      botId: "daibai",
+      reason: "context_overflow",
+      detail: "prompt too large for this model",
+      atMs: 1000,
+    });
+
+    expect(capsule).not.toBeNull();
+    expect(capsule?.status).toBe("candidate");
+    // 关键：不自审自批（原实现直接写 approvedBy = 自己）。
+    expect(capsule?.approvedBy).toBeUndefined();
+    expect(capsule?.approvedAt).toBeUndefined();
+    expect(capsule?.createdBy).toBe("daibai");
+    expect(capsule?.groupId).toBe("agent:daibai");
+  });
+
+  it("classifies failures and rejections as anti-patterns", () => {
+    expect(
+      deriveCandidateCapsule({
+        trigger: "task_failure",
+        scopeId: "grp-1",
+        botId: "bot-1",
+        reason: "agent_error_before_reply",
+      })?.capsuleType,
+    ).toBe("anti_pattern");
+    expect(
+      deriveCandidateCapsule({
+        trigger: "review_rejected",
+        scopeId: "grp-1",
+        botId: "bot-1",
+        reason: "missing_tests",
+      })?.capsuleType,
+    ).toBe("anti_pattern");
+  });
+
+  it("classifies human takeover as a lesson", () => {
+    const capsule = deriveCandidateCapsule({
+      trigger: "human_takeover",
+      scopeId: "grp-1",
+      botId: "bot-1",
+      reason: "user_took_over",
+    });
+    expect(capsule?.capsuleType).toBe("lesson");
+    expect(capsule?.sourceType).toBe("session");
+  });
+
+  it("carries a recallable summary", () => {
+    const capsule = deriveCandidateCapsule({
+      trigger: "task_failure",
+      scopeId: "grp-1",
+      botId: "bot-1",
+      reason: "run_slot_unavailable",
+      detail: "并发已达上限",
+    });
+    expect(capsule?.summary).toBe("任务失败（run_slot_unavailable）：并发已达上限");
+    expect(capsule?.structuredContent).toMatchObject({
+      trigger: "task_failure",
+      reason: "run_slot_unavailable",
+      detail: "并发已达上限",
+    });
+  });
+
+  it("keeps secret scopes group-only", () => {
+    const capsule = deriveCandidateCapsule({
+      trigger: "task_failure",
+      scopeId: "grp-1",
+      botId: "bot-1",
+      reason: "boom",
+      confidentialityTier: "secret",
+    });
+    expect(capsule?.sensitivity).toBe("secret");
+    expect(capsule?.reusability).toBe("group_only");
+    expect(capsule?.confidentialityScope).toBe("group");
+  });
+
+  it("redacts secrets out of raw error detail before persisting", () => {
+    const capsule = deriveCandidateCapsule({
+      trigger: "task_failure",
+      scopeId: "grp-1",
+      botId: "bot-1",
+      reason: "provider_auth_failed",
+      detail: 'upstream 401: api_key="sk-abcdef0123456789" Bearer eyJhbGciOi.z9 failed',
+    });
+
+    const serialized = JSON.stringify(capsule);
+    expect(serialized).not.toContain("sk-abcdef0123456789");
+    expect(serialized).not.toContain("eyJhbGciOi.z9");
+    expect(capsule?.summary).toContain("***");
+  });
+
+  it("redacts before truncating so a cut cannot leave a partial key", () => {
+    const capsule = deriveCandidateCapsule({
+      trigger: "task_failure",
+      scopeId: "grp-1",
+      botId: "bot-1",
+      reason: "boom",
+      detail: `${"x".repeat(560)} sk-abcdefghijklmnop0123456789`,
+    });
+    expect(JSON.stringify(capsule)).not.toContain("sk-abcdefghijklmnop");
+  });
+
+  it("returns null on insufficient input instead of writing junk", () => {
+    expect(
+      deriveCandidateCapsule({
+        trigger: "task_failure",
+        scopeId: "  ",
+        botId: "bot-1",
+        reason: "boom",
+      }),
+    ).toBeNull();
+    expect(
+      deriveCandidateCapsule({
+        trigger: "task_failure",
+        scopeId: "grp-1",
+        botId: "bot-1",
+        reason: "   ",
+      }),
+    ).toBeNull();
+  });
+});
+
+describe("buildExperienceLesson", () => {
+  it("collapses whitespace and tolerates missing detail", () => {
+    expect(
+      buildExperienceLesson({
+        trigger: "review_rejected",
+        reason: "no_regression_test",
+        detail: "  评审要求\n补一个回归测试  ",
+      }),
+    ).toBe("评审驳回（no_regression_test）：评审要求 补一个回归测试");
+    expect(buildExperienceLesson({ trigger: "task_failure", reason: "boom" })).toBe(
+      "任务失败（boom）",
+    );
+  });
+});
diff --git a/src/gateway/agent-growth/experience-capsule.ts b/src/gateway/agent-growth/experience-capsule.ts
new file mode 100644
index 0000000000..1884561ef7
--- /dev/null
+++ b/src/gateway/agent-growth/experience-capsule.ts
@@ -0,0 +1,164 @@
+/**
+ * 经验提炼：从**失败与驳回**产出候选经验胶囊（Candidate Capsule）。
+ *
+ * 补齐此前缺失的触发源。原实现只有一条路径——「压缩前 memory flush 完成」——那本质是
+ * 顺手存档，不是复盘；仓库里没有任何 failure/rejection → capsule 的通路，也就没有
+ * 「我犯了错会被记成别这样干」的实现。
+ *
+ * 本模块是纯函数（无 I/O），落盘与治理在 `capsule-governance.ts` / backflow 侧。
+ * 产出的胶囊一律是 `status: "candidate"`，**不自动晋升**，必须经审批。
+ */
+
+import type {
+  CapsuleSensitivity,
+  CapsuleSourceType,
+  GroupMemoryCapsule,
+  GroupMemoryCapsuleType,
+  ParticipationConfidentialityTier,
+} from "@openbot/collaboration-core";
+import { redactSecretText } from "../../infra/redact-secret-text.js";
+
+/** 触发经验提炼的事件类型。 */
+export type ExperienceTrigger =
+  /** 任务执行失败（runner 报错、上下文溢出、资源不可用等）。 */
+  | "task_failure"
+  /** 交付被评审驳回。 */
+  | "review_rejected"
+  /** 人类接管——最强的"我干得不好"信号。 */
+  | "human_takeover";
+
+export type DeriveCandidateCapsuleInput = {
+  trigger: ExperienceTrigger;
+  /** 存储作用域：协作群 groupId，或单聊的 `agent:<agentId>` 个人作用域。 */
+  scopeId: string;
+  botId: string;
+  /** 机器可读的失败原因（如 `context_overflow`）。 */
+  reason: string;
+  /** 人类可读细节；会被截断且不进入提示词以外的地方。 */
+  detail?: string | null;
+  confidentialityTier?: ParticipationConfidentialityTier;
+  sourceIds?: string[];
+  participationId?: string;
+  capsuleId?: string;
+  atMs?: number;
+};
+
+const TRIGGER_LABEL: Record<ExperienceTrigger, string> = {
+  task_failure: "任务失败",
+  review_rejected: "评审驳回",
+  human_takeover: "人工接管",
+};
+
+/**
+ * 失败与驳回记为 `anti_pattern`（"别这样干"）；接管记为 `lesson`（"这里我不够好"）。
+ */
+const TRIGGER_CAPSULE_TYPE: Record<ExperienceTrigger, GroupMemoryCapsuleType> = {
+  task_failure: "anti_pattern",
+  review_rejected: "anti_pattern",
+  human_takeover: "lesson",
+};
+
+const TRIGGER_SOURCE_TYPE: Record<ExperienceTrigger, CapsuleSourceType> = {
+  task_failure: "task",
+  review_rejected: "review",
+  human_takeover: "session",
+};
+
+const DETAIL_MAX_CHARS = 600;
+const REASON_MAX_CHARS = 120;
+
+function mapTierToSensitivity(
+  tier: ParticipationConfidentialityTier | undefined,
+): CapsuleSensitivity {
+  switch (tier) {
+    case "public":
+      return "public";
+    case "restricted":
+      return "restricted";
+    case "secret":
+      return "secret";
+    default:
+      return "internal";
+  }
+}
+
+/**
+ * Collapse whitespace, redact secrets, then truncate.
+ *
+ * Redaction matters here because `detail` is raw runner/provider error text: it is
+ * persisted in the capsule, rendered into the agent's system prompt on recall, and
+ * in group scopes can be projected into another bot's learning assets. Only
+ * transient-HTTP errors are sanitized upstream, so non-transient messages arrive raw.
+ * Redaction runs before truncation so a cut mid-token cannot leave a partial key.
+ */
+function normalizeText(value: string | null | undefined, max: number): string {
+  return redactSecretText((value ?? "").replace(/\s+/g, " ").trim()).slice(0, max);
+}
+
+/** 由触发信息构造一句话教训（进提示词的就是这句）。 */
+export function buildExperienceLesson(params: {
+  trigger: ExperienceTrigger;
+  reason: string;
+  detail?: string | null;
+}): string {
+  const reason = normalizeText(params.reason, REASON_MAX_CHARS) || "unknown";
+  const detail = normalizeText(params.detail, DETAIL_MAX_CHARS);
+  const head = `${TRIGGER_LABEL[params.trigger]}（${reason}）`;
+  return detail ? `${head}：${detail}` : head;
+}
+
+/**
+ * 产出候选经验胶囊。
+ *
+ * 返回 `null` 表示输入不足以形成可复盘的经验（缺作用域/主体/原因），不写垃圾数据。
+ */
+export function deriveCandidateCapsule(
+  input: DeriveCandidateCapsuleInput,
+): GroupMemoryCapsule | null {
+  const scopeId = input.scopeId.trim();
+  const botId = input.botId.trim();
+  const reason = normalizeText(input.reason, REASON_MAX_CHARS);
+  if (!scopeId || !botId || !reason) {
+    return null;
+  }
+  const now = input.atMs ?? Date.now();
+  const summary = buildExperienceLesson({
+    trigger: input.trigger,
+    reason,
+    detail: input.detail,
+  });
+  const sensitivity = mapTierToSensitivity(input.confidentialityTier);
+
+  return {
+    capsuleId: input.capsuleId ?? `experience:${input.trigger}:${now}:${reason}`,
+    groupId: scopeId,
+    sourceType: TRIGGER_SOURCE_TYPE[input.trigger],
+    ...(input.sourceIds && input.sourceIds.length > 0
+      ? { sourceIds: [...new Set(input.sourceIds.filter(Boolean))] }
+      : {}),
+    capsuleType: TRIGGER_CAPSULE_TYPE[input.trigger],
+    title: `${TRIGGER_LABEL[input.trigger]}复盘：${reason}`,
+    summary,
+    structuredContent: {
+      trigger: input.trigger,
+      reason,
+      ...(normalizeText(input.detail, DETAIL_MAX_CHARS)
+        ? { detail: normalizeText(input.detail, DETAIL_MAX_CHARS) }
+        : {}),
+    },
+    sensitivity,
+    // 失败经验默认可晋升为个人资产；secret 场景不外流。
+    reusability: sensitivity === "secret" ? "group_only" : "promotable",
+    confidentialityScope: sensitivity === "secret" ? "group" : "tenant",
+    createdBy: botId,
+    // 关键：候选态。不写 approvedBy/approvedAt —— 自审自批是原实现的问题所在。
+    status: "candidate",
+    createdAt: now,
+    updatedAt: now,
+    metadata: {
+      origin: "experience_derivation",
+      trigger: input.trigger,
+      ...(input.participationId ? { sourceParticipationId: input.participationId } : {}),
+    },
+  };
+}
