index 0000000000..0f7604e275
--- /dev/null
+++ b/src/gateway/collaboration-learning/capsule-governance.test.ts
@@ -0,0 +1,93 @@
+/**
+ * 纯状态迁移的合法性（不碰存储）。
+ *
+ * 这套「纯迁移 + 存储分离」的结构采纳自 main 上 `f12ffd6112`（Agent: kiro-daibai）的同名
+ * 模块设计 —— 那版把合法性判定做成纯函数,比把 approve 与投影/晋升糅在一个 async 函数里
+ * 更可测。收敛时保留该结构,并补上原实现缺的驳回审计字段。
+ */
+
+import type { GroupMemoryCapsule } from "@openbot/collaboration-core";
+import { describe, expect, it } from "vitest";
+import {
+  applyCapsuleGovernanceTransition,
+  CapsuleGovernanceError,
+  isCandidateCapsule,
+} from "./capsule-governance.js";
+
+function makeCapsule(overrides: Partial<GroupMemoryCapsule> = {}): GroupMemoryCapsule {
+  return {
+    capsuleId: "cap-1",
+    groupId: "grp-1",
+    status: "candidate",
+    ...overrides,
+  };
+}
+
+describe("isCandidateCapsule", () => {
+  it("treats a capsule with no explicit status as candidate", () => {
+    expect(isCandidateCapsule(makeCapsule({ status: undefined }))).toBe(true);
+  });
+
+  it("does not treat approved/revoked as candidate", () => {
+    expect(isCandidateCapsule(makeCapsule({ status: "approved" }))).toBe(false);
+    expect(isCandidateCapsule(makeCapsule({ status: "revoked" }))).toBe(false);
+  });
+});
+
+describe("applyCapsuleGovernanceTransition", () => {
+  it("approves a candidate and stamps the actor", () => {
+    const next = applyCapsuleGovernanceTransition(makeCapsule(), "approved", {
+      actor: "peter",
+      nowMs: 1000,
+    });
+    expect(next.status).toBe("approved");
+    expect(next.approvedBy).toBe("peter");
+    expect(next.approvedAt).toBe(1000);
+    expect(next.updatedAt).toBe(1000);
+  });
+
+  it("refuses to approve anything that is not a candidate", () => {
+    expect(() =>
+      applyCapsuleGovernanceTransition(makeCapsule({ status: "approved" }), "approved"),
+    ).toThrow(CapsuleGovernanceError);
+    expect(() =>
+      applyCapsuleGovernanceTransition(makeCapsule({ status: "revoked" }), "approved"),
+    ).toThrow(/cannot approve capsule from status "revoked"/);
+  });
+
+  it("revokes from candidate and from approved, with audit fields", () => {
+    const fromCandidate = applyCapsuleGovernanceTransition(makeCapsule(), "revoked", {
+      actor: "peter",
+      nowMs: 2000,
+      rejectionReason: "  重复经验  ",
+    });
+    expect(fromCandidate.status).toBe("revoked");
+    expect(fromCandidate.rejectedBy).toBe("peter");
+    expect(fromCandidate.rejectedAt).toBe(2000);
+    expect(fromCandidate.rejectionReason).toBe("重复经验");
+
+    expect(
+      applyCapsuleGovernanceTransition(makeCapsule({ status: "approved" }), "revoked").status,
+    ).toBe("revoked");
+  });
+
+  it("refuses to revoke an already revoked capsule (no silent no-op)", () => {
+    expect(() =>
+      applyCapsuleGovernanceTransition(makeCapsule({ status: "revoked" }), "revoked"),
+    ).toThrow(/cannot revoke capsule from status "revoked"/);
+  });
+
+  it("does not mutate the input capsule", () => {
+    const capsule = makeCapsule();
+    applyCapsuleGovernanceTransition(capsule, "approved", { actor: "peter" });
+    expect(capsule.status).toBe("candidate");
+    expect(capsule.approvedBy).toBeUndefined();
+  });
+
+  it("omits the rejection reason when blank", () => {
+    const next = applyCapsuleGovernanceTransition(makeCapsule(), "revoked", {
+      rejectionReason: "   ",
+    });
+    expect(next.rejectionReason).toBeUndefined();
+  });
+});
diff --git a/src/gateway/collaboration-learning/review-rejection-experience.ts b/src/gateway/collaboration-learning/review-rejection-experience.ts
new file mode 100644
index 0000000000..52fafbc1ce
--- /dev/null
+++ b/src/gateway/collaboration-learning/review-rejection-experience.ts
@@ -0,0 +1,130 @@
+/**
+ * 评审驳回 → 候选经验胶囊。
+ *
+ * 本仓库的交付物状态机里没有显式的 "rejected" 状态；真正的驳回信号是
+ * **`in_review` → `submitted`**（评审把交付物退回给作者，见
+ * `packages/collaboration-core/src/state-machines/deliverable.ts` 的转移表）。
+ * 这里只认这一条边，避免把正常的 `submitted → draft` 编辑回退误判成驳回。
+ *
+ * 与失败复盘一致：产出 `candidate`，不自动晋升，必须走 `capsule-governance` 审批。
+ */
+
+import type { Deliverable, GroupMemoryCapsule } from "@openbot/collaboration-core";
+import { logVerbose } from "../../globals.js";
+import { deriveCandidateCapsule } from "../agent-growth/experience-capsule.js";
+import { normalizeConfidentialityTier } from "./shared.js";
+
+/** 判定一次交付物状态变化是否构成评审驳回。 */
+export function isReviewRejection(params: {
+  fromStatus: Deliverable["status"];
+  toStatus: Deliverable["status"];
+}): boolean {
+  return params.fromStatus === "in_review" && params.toStatus === "submitted";
+}
+
+/**
+ * 归属主体：被驳回的工作属于提交者。
+ * 没有提交者时回落到创建者；都没有则无法归属，不产出胶囊。
+ */
+export function resolveRejectedDeliverableOwner(deliverable: Deliverable): string | null {
+  return deliverable.submittedBy?.trim() || deliverable.createdBy?.trim() || null;
+}
+
+export function buildReviewRejectionCapsule(params: {
+  deliverable: Deliverable;
+  actor?: string;
+  confidentialityTier?: string | null;
+  atMs?: number;
+}): GroupMemoryCapsule | null {
+  const botId = resolveRejectedDeliverableOwner(params.deliverable);
+  if (!botId) {
+    return null;
+  }
+  const title = params.deliverable.title?.trim();
+  return deriveCandidateCapsule({
+    trigger: "review_rejected",
+    scopeId: params.deliverable.groupId,
+    botId,
+    reason: "deliverable_returned_from_review",
+    detail: [
+      title ? `交付物「${title}」被评审退回` : "交付物被评审退回",
+      params.actor?.trim() ? `退回人：${params.actor.trim()}` : "",
+    ]
+      .filter(Boolean)
+      .join("；"),
+    confidentialityTier: normalizeConfidentialityTier(params.confidentialityTier),
+    sourceIds: [params.deliverable.deliverableId],
+    ...(params.atMs !== undefined ? { atMs: params.atMs } : {}),
+  });
+}
+
+/** 落盘（fire-and-forget 语义由调用方决定）；重复驳回同一交付物只保留最新一条候选。 */
+export async function recordReviewRejectionExperience(params: {
+  deliverable: Deliverable;
+  fromStatus: Deliverable["status"];
+  actor?: string;
+  learningStorage: {
+    readCapsules: (groupId: string) => Promise<GroupMemoryCapsule[]>;
+    writeCapsules: (groupId: string, capsules: GroupMemoryCapsule[]) => Promise<void>;
+    appendCapsule: (groupId: string, capsule: GroupMemoryCapsule) => Promise<void>;
+  };
+  metadataStorage?: {
+    readGroupCapabilities: (
+      groupId: string,
+    ) => Promise<{ confidentialityTier?: string | null } | null>;
+  };
+  atMs?: number;
+}): Promise<{ capsuleId?: string; skipped?: string }> {
+  if (!isReviewRejection({ fromStatus: params.fromStatus, toStatus: params.deliverable.status })) {
+    return { skipped: "not_a_review_rejection" };
+  }
+  const capabilities = await params.metadataStorage
+    ?.readGroupCapabilities(params.deliverable.groupId)
+    .catch(() => null);
+  const capsule = buildReviewRejectionCapsule({
+    deliverable: params.deliverable,
+    ...(params.actor ? { actor: params.actor } : {}),
+    confidentialityTier: capabilities?.confidentialityTier ?? null,
+    ...(params.atMs !== undefined ? { atMs: params.atMs } : {}),
+  });
+  if (!capsule) {
+    return { skipped: "missing_deliverable_owner" };
+  }
+
+  const existing = await params.learningStorage.readCapsules(params.deliverable.groupId);
+  const supersededIds = new Set(
+    existing
+      .filter(
+        (entry) =>
+          entry.status === "candidate" &&
+          entry.metadata?.trigger === "review_rejected" &&
+          entry.sourceIds?.includes(params.deliverable.deliverableId),
+      )
+      .map((entry) => entry.capsuleId),
+  );
+  if (supersededIds.size > 0) {
+    await params.learningStorage.writeCapsules(
+      params.deliverable.groupId,
+      existing.filter((entry) => !supersededIds.has(entry.capsuleId)),
+    );
+  }
+  await params.learningStorage.appendCapsule(params.deliverable.groupId, capsule);
+  return { capsuleId: capsule.capsuleId };
+}
+
+/** 永不 reject 的包装：状态机转移不能因为经验提炼失败而回滚。 */
+export function recordReviewRejectionExperienceSafely(
+  params: Parameters<typeof recordReviewRejectionExperience>[0],
+): void {
+  void recordReviewRejectionExperience(params)
+    .then((result) => {
+      if (result.capsuleId) {
+        logVerbose(
+          `review rejection experience: deliverable=${params.deliverable.deliverableId} capsule=${result.capsuleId}`,
+        );
+      }
+    })
+    .catch((err) => {
+      logVerbose(`review rejection experience failed: ${String(err)}`);
+    });
+}
diff --git a/src/gateway/enterprise-data/connector-credential-vault-key.ts b/src/gateway/enterprise-data/connector-credential-vault-key.ts
new file mode 100644
index 0000000000..0a368e03fc
--- /dev/null
+++ b/src/gateway/enterprise-data/connector-credential-vault-key.ts
@@ -0,0 +1,75 @@
+/**
+ * Shared AES-256-GCM vault key resolution for enterprise credential vaults.
+ *
+ * Extracted so every enterprise vault (data connectors, model connections) derives
+ * its key the same way instead of each file re-implementing key handling. Per
+ * spec requirement "reuse existing credential vault patterns; do not invent new
+ * crypto", this module owns the single key-derivation implementation and adds no
+ * new algorithm: the material is hashed to 32 bytes with SHA-256, exactly as the
+ * original connector vault did.
+ *
+ * When an env var supplies the key material, the on-disk key file is neither read
+ * nor written, so enterprises can keep the key in an external secret manager.
+ */
+
+import { createHash } from "node:crypto";
+
+export type VaultKeyMaterial = {
+  /** Raw key material (any string); callers must hash it via `deriveVaultKey`. */
+  material: string;
+  /** Env var the material came from, for diagnostics. Never log `material`. */
+  source: string;
+};
+
+/**
+ * Generic key applying to every enterprise vault. Used as the default lookup, so
+ * a vault without its own dedicated env var still supports external key management.
+ * `OPENCLAW_*` stays as a back-compat alias per repo env conventions.
+ */
+export const ENTERPRISE_VAULT_KEY_ENV_VARS = [
+  "OPENBOT_ENTERPRISE_VAULT_KEY",
+  "OPENCLAW_ENTERPRISE_VAULT_KEY",
+] as const;
+
+/** Data-connector vault key vars (kept for back-compat with existing deployments). */
+export const ENTERPRISE_DATA_VAULT_KEY_ENV_VARS = [
+  "OPENBOT_ENTERPRISE_DATA_VAULT_KEY",
+  "OPENCLAW_ENTERPRISE_DATA_VAULT_KEY",
+] as const;
+
+/** Derive the 32-byte AES-256 key from arbitrary key material. */
+export function deriveVaultKey(material: string): Buffer {
+  return createHash("sha256").update(material).digest();
+}
+
+/**
+ * Read vault key material from the environment (first non-empty var wins).
+ * Returns `null` when no var is set, so callers fall back to their local key file.
+ */
+export function readVaultKeyMaterialFromEnv(
+  envVarNames: readonly string[] = ENTERPRISE_VAULT_KEY_ENV_VARS,
+  env: NodeJS.ProcessEnv = process.env,
+): VaultKeyMaterial | null {
+  for (const name of envVarNames) {
+    const value = env[name]?.trim();
+    if (value) {
+      return { material: value, source: name };
+    }
+  }
+  return null;
+}
+
+/**
+ * Promise-returning wrapper over {@link readVaultKeyMaterialFromEnv}.
+ *
+ * Vault callers resolve keys on an async path (they already `await` this), and
+ * keeping the async boundary here means a future key source that needs I/O — a
+ * secret file or external secret manager — can be added without touching callers.
+ * Deliberately not declared `async`: there is nothing to await today.
+ */
+export function resolveVaultKeyMaterialFromEnv(
+  envVarNames: readonly string[] = ENTERPRISE_VAULT_KEY_ENV_VARS,
+  env: NodeJS.ProcessEnv = process.env,
+): Promise<VaultKeyMaterial | null> {
+  return Promise.resolve(readVaultKeyMaterialFromEnv(envVarNames, env));
+}
diff --git a/src/gateway/enterprise-model/asset-store.ts b/src/gateway/enterprise-model/asset-store.ts
new file mode 100644
index 0000000000..b127068b6e
--- /dev/null
+++ b/src/gateway/enterprise-model/asset-store.ts
@@ -0,0 +1,289 @@
+/**
+ * Tenant-keyed enterprise BYOK model asset store.
+ * Spec: `.kiro/specs/enterprise-ai-model-governance/`
+ */
+
+import { randomUUID } from "node:crypto";
+import path from "node:path";
+import { createAsyncLock, readJsonFile, writeJsonAtomic } from "../../infra/json-files.js";
+import { CONFIG_DIR, resolveUserPath } from "../../utils.js";
+import { canonicalizeTenantId } from "../tenant-canonicalization.js";
+import { EnterpriseModelError } from "./errors.js";
+import { buildRuntimeModelId } from "./ids.js";
+import type { EnterpriseModelAsset, EnterpriseModelHealthStatus } from "./types.js";
+
+const STORE_VERSION = 1;
+
+type Store = {
+  version: number;
+  assets: Record<string, EnterpriseModelAsset>;
+};
+
+function createEmptyStore(): Store {
+  return { version: STORE_VERSION, assets: {} };
+}
+
+export function resolveDefaultAssetStorePath(): string {
+  return path.join(CONFIG_DIR, "openbot-enterprise-model-assets.json");
+}
+
+const withLock = createAsyncLock();
+
+async function loadStore(storePath?: string): Promise<Store> {
+  const resolvedPath = resolveUserPath(storePath?.trim() || resolveDefaultAssetStorePath());
+  const parsed = await readJsonFile<Partial<Store>>(resolvedPath);
+  if (!parsed || typeof parsed.assets !== "object" || parsed.assets === null) {
+    return createEmptyStore();
+  }
+  return { version: STORE_VERSION, assets: parsed.assets };
+}
+
+async function saveStore(store: Store, storePath?: string): Promise<void> {
+  const resolvedPath = resolveUserPath(storePath?.trim() || resolveDefaultAssetStorePath());
+  await writeJsonAtomic(resolvedPath, store);
+}
+
+export async function listEnterpriseModelAssets(
+  tenantId: string,
+  opts?: { connectionId?: string; enabledOnly?: boolean; storePath?: string },
+): Promise<EnterpriseModelAsset[]> {
+  const canonical = canonicalizeTenantId(tenantId);
+  if (!canonical) {
+    return [];
+  }
+  const store = await loadStore(opts?.storePath);
+  return Object.values(store.assets)
+    .filter((row) => {
+      if (row.tenantId !== canonical) {
+        return false;
+      }
+      if (opts?.connectionId && row.connectionId !== opts.connectionId) {
+        return false;
+      }
+      if (opts?.enabledOnly && !row.enabled) {
+        return false;
+      }
+      return true;
+    })
+    .toSorted((a, b) => a.displayName.localeCompare(b.displayName));
+}
+
+export async function getEnterpriseModelAsset(
+  tenantId: string,
+  assetId: string,
+  storePath?: string,
+): Promise<EnterpriseModelAsset | null> {
+  const canonical = canonicalizeTenantId(tenantId);
+  if (!canonical) {
+    return null;
+  }
+  const store = await loadStore(storePath);
+  const row = store.assets[assetId];
+  if (!row || row.tenantId !== canonical) {
+    return null;
+  }
+  return row;
+}
+
+export async function getEnterpriseModelAssetByRuntimeId(
+  tenantId: string,
+  runtimeModelId: string,
+  storePath?: string,
+): Promise<EnterpriseModelAsset | null> {
+  const canonical = canonicalizeTenantId(tenantId);
+  if (!canonical) {
+    return null;
+  }
+  const store = await loadStore(storePath);
+  const needle = runtimeModelId.trim();
+  return (
+    Object.values(store.assets).find(
+      (row) => row.tenantId === canonical && row.runtimeModelId === needle,
+    ) ?? null
+  );
+}
+
+export async function listActiveTenantOwnedModelIds(
+  tenantId: string,
+  storePath?: string,
+): Promise<string[]> {
+  const assets = await listEnterpriseModelAssets(tenantId, {
+    enabledOnly: true,
+    storePath,
+  });
+  return [
+    ...new Set(
+      assets
+        .filter((a) => a.healthStatus !== "unhealthy")
+        .map((a) => a.runtimeModelId.trim())
+        .filter(Boolean),
+    ),
+  ];
+}
+
+export async function registerEnterpriseModelAsset(
+  input: {
+    tenantId: string;
+    connectionId: string;
+    upstreamModelId: string;
+    displayName?: string;
+    tier?: string;
+    capabilities?: string[];
+    contextWindow?: number;
+    cost?: EnterpriseModelAsset["cost"];
+    enabled?: boolean;
+    healthStatus?: EnterpriseModelHealthStatus;
+    assetId?: string;
+  },
+  storePath?: string,
+): Promise<EnterpriseModelAsset> {
+  const canonical = canonicalizeTenantId(input.tenantId);
+  if (!canonical) {
+    throw new EnterpriseModelError("ENTERPRISE_MODEL_INVALID_REQUEST", "invalid tenantId");
+  }
+  const upstreamModelId = input.upstreamModelId.trim();
+  if (!upstreamModelId) {
+    throw new EnterpriseModelError("ENTERPRISE_MODEL_INVALID_REQUEST", "upstreamModelId required");
+  }
+  const runtimeModelId = buildRuntimeModelId({
+    tenantId: canonical,
+    connectionId: input.connectionId,
+    upstreamModelId,
+  });
+  return withLock(async () => {
+    const store = await loadStore(storePath);
+    const duplicate = Object.values(store.assets).find(
+      (row) =>
+        row.tenantId === canonical &&
+        row.connectionId === input.connectionId &&
+        row.upstreamModelId === upstreamModelId,
+    );
+    if (duplicate) {
+      throw new EnterpriseModelError(
+        "ENTERPRISE_MODEL_INVALID_REQUEST",
+        `model already registered: ${upstreamModelId}`,
+      );
+    }
+    const now = new Date().toISOString();
+    const record: EnterpriseModelAsset = {
+      tenantId: canonical,
+      assetId: input.assetId?.trim() || randomUUID(),
+      connectionId: input.connectionId,
+      runtimeModelId,
+      upstreamModelId,
+      displayName: input.displayName?.trim() || upstreamModelId,
+      source: "enterprise",
+      billingOwner: "enterprise",
+      ...(input.tier ? { tier: input.tier } : {}),
+      ...(input.capabilities ? { capabilities: [...input.capabilities] } : {}),
+      enabled: input.enabled !== false,
+      healthStatus: input.healthStatus ?? "unknown",
+      ...(typeof input.contextWindow === "number" ? { contextWindow: input.contextWindow } : {}),
+      ...(input.cost ? { cost: input.cost } : {}),
+      createdAt: now,
+      updatedAt: now,
+    };
+    store.assets[record.assetId] = record;
+    await saveStore(store, storePath);
+    return record;
+  });
+}
+
+export async function updateEnterpriseModelAsset(
+  input: {
+    tenantId: string;
+    assetId: string;
+    displayName?: string;
+    tier?: string | null;
+    capabilities?: string[];
+    enabled?: boolean;
+    healthStatus?: EnterpriseModelHealthStatus;
+    contextWindow?: number | null;
+    cost?: EnterpriseModelAsset["cost"] | null;
+  },
+  storePath?: string,
+): Promise<EnterpriseModelAsset> {
+  const canonical = canonicalizeTenantId(input.tenantId);
+  if (!canonical) {
+    throw new EnterpriseModelError("ENTERPRISE_MODEL_INVALID_REQUEST", "invalid tenantId");
+  }
+  return withLock(async () => {
+    const store = await loadStore(storePath);
+    const existing = store.assets[input.assetId];
+    if (!existing || existing.tenantId !== canonical) {
+      throw new EnterpriseModelError("ENTERPRISE_MODEL_NOT_FOUND", "asset not found");
+    }
+    const next: EnterpriseModelAsset = {
+      ...existing,
+      ...(input.displayName !== undefined ? { displayName: input.displayName.trim() } : {}),
+      ...(input.capabilities !== undefined ? { capabilities: [...input.capabilities] } : {}),
+      ...(input.enabled !== undefined ? { enabled: input.enabled } : {}),
+      ...(input.healthStatus !== undefined ? { healthStatus: input.healthStatus } : {}),
+      updatedAt: new Date().toISOString(),
+    };
+    if (input.tier === null) {
+      delete next.tier;
+    } else if (typeof input.tier === "string") {
+      next.tier = input.tier;
+    }
+    if (input.contextWindow === null) {
+      delete next.contextWindow;
+    } else if (typeof input.contextWindow === "number") {
+      next.contextWindow = input.contextWindow;
+    }
+    if (input.cost === null) {
+      delete next.cost;
+    } else if (input.cost) {
+      next.cost = input.cost;
+    }
+    store.assets[input.assetId] = next;
+    await saveStore(store, storePath);
+    return next;
+  });
+}
+
+export async function setEnterpriseModelAssetEnabled(
+  tenantId: string,
+  assetId: string,
+  enabled: boolean,
+  storePath?: string,
+): Promise<EnterpriseModelAsset> {
+  return updateEnterpriseModelAsset({ tenantId, assetId, enabled }, storePath);
+}
+
+export async function deleteEnterpriseModelAssetsForConnection(
+  tenantId: string,
+  connectionId: string,
+  storePath?: string,
+): Promise<number> {
+  const canonical = canonicalizeTenantId(tenantId);
+  if (!canonical) {
+    return 0;
+  }
+  return withLock(async () => {
+    const store = await loadStore(storePath);
+    let removed = 0;
+    for (const [id, row] of Object.entries(store.assets)) {
+      if (row.tenantId === canonical && row.connectionId === connectionId) {
+        delete store.assets[id];
+        removed += 1;
+      }
+    }
+    if (removed > 0) {
+      await saveStore(store, storePath);
+    }
+    return removed;
+  });
+}
+
+export async function countAssetsReferencingConnection(
+  tenantId: string,
+  connectionId: string,
+  storePath?: string,
+): Promise<{ total: number; enabled: number }> {
+  const assets = await listEnterpriseModelAssets(tenantId, { connectionId, storePath });
+  return {
+    total: assets.length,
+    enabled: assets.filter((a) => a.enabled).length,
+  };
+}
diff --git a/src/gateway/enterprise-model/runtime-resolve.ts b/src/gateway/enterprise-model/runtime-resolve.ts
new file mode 100644
index 0000000000..ed942e814f
--- /dev/null
+++ b/src/gateway/enterprise-model/runtime-resolve.ts
@@ -0,0 +1,88 @@
+/**
+ * Per-request tenant model runtime config for BYOK invocation.
+ * MUST NOT mutate global loadConfig() / process-level provider state.
+ */
+
+import { getEnterpriseModelAssetByRuntimeId } from "./asset-store.js";
+import { getEnterpriseModelConnection } from "./connection-store.js";
+import { loadEnterpriseModelSecret } from "./credential-vault.js";
+import { EnterpriseModelError } from "./errors.js";
+import { isEnterpriseRuntimeModelId } from "./ids.js";
+
+export type TenantModelRuntimeConfig = {
+  tenantId: string;
+  runtimeModelId: string;
+  upstreamModelId: string;
+  connectionId: string;
+  providerType: string;
+  protocol: string;
+  baseUrl?: string;
+  apiKey: string;
+  billingOwner: "enterprise";
+  source: "enterprise";
+};
+
+export async function resolveTenantModelRuntimeConfig(params: {
+  tenantId: string;
+  runtimeModelId: string;
+  connectionStorePath?: string;
+  assetStorePath?: string;
+  vaultPath?: string;
+}): Promise<TenantModelRuntimeConfig | null> {
+  if (!isEnterpriseRuntimeModelId(params.runtimeModelId)) {
+    return null;
+  }
+  const asset = await getEnterpriseModelAssetByRuntimeId(
+    params.tenantId,
+    params.runtimeModelId,
+    params.assetStorePath,
+  );
+  if (!asset) {
+    throw new EnterpriseModelError(
+      "ENTERPRISE_MODEL_NOT_FOUND",
+      "enterprise model asset not found for tenant",
+    );
+  }
+  if (!asset.enabled) {
+    throw new EnterpriseModelError(
+      "ENTERPRISE_MODEL_FORBIDDEN",
+      "enterprise model asset is disabled",
+    );
+  }
+  if (asset.healthStatus === "unhealthy") {
+    throw new EnterpriseModelError(
+      "ENTERPRISE_MODEL_MODEL_UNAVAILABLE",
+      "enterprise model asset is unhealthy",
+    );
+  }
+  const connection = await getEnterpriseModelConnection(
+    params.tenantId,
+    asset.connectionId,
+    params.connectionStorePath,
+  );
+  if (!connection || connection.status === "disabled") {
+    throw new EnterpriseModelError(
+      "ENTERPRISE_MODEL_FORBIDDEN",
+      "enterprise model connection is unavailable",
+    );
+  }
+  const secret = await loadEnterpriseModelSecret(connection.credentialRef, params.vaultPath);
+  if (!secret?.apiKey?.trim()) {
+    throw new EnterpriseModelError(
+      "ENTERPRISE_MODEL_INVALID_CREDENTIAL",
+      "enterprise model credential missing",
+    );
+  }
+  return {
+    tenantId: params.tenantId,
+    runtimeModelId: asset.runtimeModelId,
+    upstreamModelId: asset.upstreamModelId,
+    connectionId: connection.connectionId,
+    providerType: connection.providerType,
+    protocol: connection.protocol,
+    ...(connection.baseUrl ? { baseUrl: connection.baseUrl } : {}),
+    apiKey: secret.apiKey,
+    billingOwner: "enterprise",
+    source: "enterprise",
+  };
+}
diff --git a/src/gateway/enterprise-model/store.test.ts b/src/gateway/enterprise-model/store.test.ts
