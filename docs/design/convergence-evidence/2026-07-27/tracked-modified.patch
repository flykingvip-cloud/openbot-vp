+
+export type WorkingStyleEffectStatus = "improved" | "regressed" | "inconclusive";
+
+/** 某个 agent 最近一次 Working DNA 变更及其二阶评估结果。 */
+export type WorkingStyleEffectItem = {
+  agentId: string;
+  changedAtMs: number;
+  /** 本次实际应用的行为改变（键=WorkingStyle 字段）。 */
+  appliedDelta: Record<string, unknown>;
