{
  "contractVersion": "2026-09-15.rev2",
  "vectors": [
    {
      "id": "TC001",
      "category": "idempotency",
      "description": "duplicate same idempotencyKey returns replay",
      "input": { "replay": true, "sameKey": true, "samePayload": true },
      "expected": { "verdict": "accepted", "reasonCode": "RC_DUPLICATE_REPLAY" }
    },
    {
      "id": "TC002",
      "category": "idempotency",
      "description": "same key different payload hash rejected",
      "input": { "sameKey": true, "samePayload": false },
      "expected": { "verdict": "rejected", "reasonCode": "RC_EVIDENCE_TAMPERED" }
    },
    {
      "id": "TC003",
      "category": "cancel_race",
      "description": "cancel effective before completion recordedAt",
      "input": {
        "cancelGeneration": 2,
        "cancelEffectiveAt": "2026-09-15T10:00:00Z",
        "completionRecordedAt": "2026-09-15T10:00:01Z",
        "primaryGeneration": 2
      },
      "expected": { "verdict": "cancelled", "reasonCode": "RC_RACE_LOST_TO_CANCEL" }
    },
    {
      "id": "TC004",
      "category": "cancel_race",
      "description": "completion before cancel wins when generation matches",
      "input": {
        "cancelGeneration": 1,
        "cancelEffectiveAt": "2026-09-15T10:00:05Z",
        "completionRecordedAt": "2026-09-15T10:00:01Z",
        "primaryGeneration": 1,
        "completionSource": "supervisor_accepted"
      },
      "expected": { "verdict": "accepted", "reasonCode": "RC_OK" }
    },
    {
      "id": "TC005",
      "category": "stale",
      "description": "subagent run superseded by retry",
      "input": {
        "subagentRunId": "run-v1",
        "bindingVersion": 2,
        "activeRunId": "run-v2"
      },
      "expected": { "verdict": "stale", "reasonCode": "RC_RUN_STALE" }
    },
    {
      "id": "TC006",
      "category": "stale",
      "description": "binding version expired",
      "input": { "bindingVersion": 1, "currentBindingVersion": 3 },
      "expected": { "verdict": "stale", "reasonCode": "RC_BINDING_STALE" }
    },
    {
      "id": "TC007",
      "category": "tenant_acl",
      "description": "group_tenant missing tenantId fail-closed",
      "input": { "scope": "group_tenant", "tenantId": null },
      "expected": { "eventAccepted": false, "reasonCode": "RC_TENANT_MISMATCH" }
    },
    {
      "id": "TC008",
      "category": "tenant_acl",
      "description": "cross tenant binding rejected",
      "input": { "eventTenantId": "tenant-a", "bindingTenantId": "tenant-b" },
      "expected": { "verdict": "rejected", "reasonCode": "RC_TENANT_MISMATCH" }
    },
    {
      "id": "TC009",
