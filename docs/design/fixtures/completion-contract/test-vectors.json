      "expected": { "verdict": "rejected", "reasonCode": "RC_SOURCE_NOT_ALLOWED", "closeCt": false }
    },
    {
      "id": "TC011",
      "category": "evidence",
      "description": "supervisor accepted with valid report",
      "input": {
        "completionSource": "supervisor_accepted",
        "evidenceReferences": [{ "kind": "supervisor_report", "ref": "sr-001" }],
        "reportStatus": "accepted"
      },
      "expected": {
        "verdict": "accepted",
        "reasonCode": "RC_OK",
        "winningSource": "supervisor_accepted"
      }
    },
    {
      "id": "TC012",
