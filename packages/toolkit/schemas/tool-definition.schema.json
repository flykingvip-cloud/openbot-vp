{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbot.love/schemas/tool-definition.schema.json",
  "title": "OpenBot Tool Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "priority",
    "purpose",
    "operations",
    "risk",
    "sideEffects",
    "dryRun",
    "idempotency",
    "verification"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "priority": { "enum": ["P0", "P1", "P2"] },
    "purpose": { "type": "string", "minLength": 1 },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "risk": { "enum": ["low", "medium", "high", "control"] },
    "sideEffects": { "type": "boolean" },
    "dryRun": { "oneOf": [{ "type": "boolean" }, { "type": "string" }] },
    "idempotency": { "type": "string", "minLength": 1 },
    "verification": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    }
  }
}
