{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "downlevelIteration": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["DOM", "DOM.Iterable", "ES2023", "ScriptHost"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noEmitOnError": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "useDefineForClassFields": false,
    "paths": {
      "@openbot/evolution-core": ["./packages/evolution-core/src/index.ts"],
      "@openbot/collaboration-core": ["./packages/collaboration-core/src/index.ts"],
      "@openbot/collaboration-runtime": ["./packages/collaboration-runtime/src/index.ts"],
      "@openbot/collaboration-openbot-adapter": [
        "./packages/collaboration-openbot-adapter/src/index.ts"
      ],
      "@openbot/aor-core": ["./packages/aor-core/src/index.ts"],
      "@openbot/toolkit": ["./packages/toolkit/src/index.ts"],
      "@openbot/aor-backend-openbot": ["./packages/aor-backend-openbot/src/index.ts"],
      "@openbot/aor-backend-stub": ["./packages/aor-backend-stub/src/index.ts"],
      "@openbot/aor-backend-graph": ["./packages/aor-backend-graph/src/index.ts"],
      "@openbot/aor-sdk-node": ["./packages/aor-sdk-node/src/index.ts"],
      "openclaw/plugin-sdk": ["./src/plugin-sdk/index.ts"],
      "openclaw/plugin-sdk/*": ["./src/plugin-sdk/*.ts"],
      "openclaw/plugin-sdk/account-id": ["./src/plugin-sdk/account-id.ts"]
    }
  },
  "include": ["src/**/*", "ui/**/*", "extensions/**/*"],
  "exclude": ["node_modules", "dist", "ui/src/ui/views/openbot-homepage.tsx"]
}
