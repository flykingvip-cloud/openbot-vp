{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "experimentalSortImports": {
    "newlinesBetween": false,
  },
  "experimentalSortPackageJson": {
    "sortScripts": true,
  },
  "tabWidth": 2,
  "useTabs": false,
  "ignorePatterns": [
    // Exact formatter regressions: table syntax changes; original bytes retained.
    "docs/acceptance/fullstack-2026-11-01/09-coverage-progress.md",
    "docs/acceptance/fullstack-2026-11-01/10-coverage-inventory-tracked.md",
    "docs/acceptance/fullstack-2026-11-01/10-pr193-review.md",
    // Existing S0 frozen evidence; see local-ui-seams/s0-limited-approval-map.
    ".kiro/specs/local-ui-seams/s0-failure-injection-test-list.md",
    ".kiro/specs/local-ui-seams/s0-legacy-rules-retirement-candidates.md",
    ".kiro/specs/local-ui-seams/s0-scene-entry-and-consumer-map.md",
    ".kiro/specs/local-ui-seams/s0-sha-and-anchor-inventory.md",
    ".kiro/specs/local-ui-seams/s0-three-role-contract-map.md",
    // Frozen / governance-protected records: must not be rewritten, not even whitespace.
    ".kiro/specs/constitutional-governance-discovery/",
    "packages/constitutional-contracts/",
    // Frozen Team A Sync-W2-1 golden fixture; raw bytes must remain SHA-256 f8033a90...
    "src/knowledge/v21-wave0/interop-fixtures/",
    // Generated outputs: regenerate via their scripts instead of formatting by hand.
    ".kiro/specs/gateway-plugins-monolith-decomposition/baseline/",
    "docs/zh-CN/",
    "apps/",
    "assets/",
    "CLAUDE.md",
    "docker-compose.yml",
    "dist/",
    "docs/_layouts/",
    "docs/design/templates/",
    "node_modules/",
    "patches/",
    "pnpm-lock.yaml/",
    "src/commands/agent.ts",
    "src/gateway/server-methods/CLAUDE.md",
    "src/gateway/server-methods/agents.ts",
    "src/gateway/server-methods/skills.ts",
    "src/gateway/workspace/handler-bridge.ts",
    "src/gateway/workspace-resolver/steward-write.ts",
    "src/memory/backend-config.ts",
    "src/memory/cogniweave-manager.ts",
    "src/memory/manager-sync-ops.ts",
    "src/memory/manager.ts",
    "src/memory/qmd-manager.ts",
    "src/auto-reply/reply/export-html/",
    "Swabble/",
    "vendor/",
  ],
}
