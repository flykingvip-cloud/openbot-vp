{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "strict": true,
    "noEmit": false,
    "outDir": "ts-generated",
    "rootDir": ".",
    "skipLibCheck": true,
    "types": ["node"],
    "noImplicitAny": true,
    "exactOptionalPropertyTypes": true
  },
  "include": ["dto.ts", "check.ts"]
}
